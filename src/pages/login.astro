---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="登录" description="使用上海交通大学 jAccount 统一身份认证登录协会网站。">
  <h1 class="page-title">登录</h1>
  <p class="page-subtitle">使用上海交通大学 jAccount 统一身份认证。</p>

  <div class="notice-bar" id="notice" hidden></div>

  <section class="section">
    <div class="card login-card">
      <!-- 未登录 -->
      <div id="anon-box">
        <a class="btn-primary" id="btn-login" href="/api/auth/login">使用 jAccount 登录</a>
        <div id="mock-box" hidden>
          <hr />
          <p class="muted">
            jAccount 接入正在审批中（交我办「jAccount 接口申请」）。
            审批通过、配置正式凭据前，可先用<strong>演示身份</strong>体验登录后的界面与交互。
          </p>
          <a class="btn-ghost" id="btn-mock" href="/api/auth/login?mock=1">演示登录（demo）</a>
        </div>
      </div>

      <!-- 已登录 -->
      <div id="user-box" hidden>
        <p class="login-welcome">
          已登录：<b id="user-name"></b>
          <span class="muted" id="user-account"></span>
          <span class="badge badge-blue" id="user-type" hidden></span>
          <span class="badge badge-gold" id="user-mock" hidden>演示身份</span>
        </p>
        <a class="btn-ghost" href="/api/auth/logout">退出登录</a>
      </div>

      <ul class="login-faq muted">
        <li>登录后可用于：<strong>集训队报名、协调组队、成员专属资料</strong>（后续功能开放时）。</li>
        <li>本站仅读取你的 <strong>jAccount 账号、姓名、学工号与身份类型</strong>（OIDC 标准 id_token），不获取密码，不读取其他校内信息。</li>
        <li>遇到「授权确认」页面属交大统一认证的正常流程；登录异常请联系协会邮箱。</li>
      </ul>
    </div>
  </section>
</BaseLayout>

<script>
  const q = new URLSearchParams(location.search);

  // 从 /api/auth/login 或 /login?notice=... 带回来的提示
  const notice = document.getElementById("notice");
  if (notice) {
    if (q.get("notice") === "pending") {
      notice.textContent = "jAccount 接入仍在审批中，暂时只能使用演示身份。";
      notice.hidden = false;
    } else if (q.get("notice") === "error") {
      notice.textContent = `登录失败：${q.get("msg") || "未知错误"}，请重试。`;
      notice.hidden = false;
    }
  }

  // 带上原目标页，登录后回跳
  const redirect = q.get("redirect");
  if (redirect && redirect.startsWith("/") && !redirect.startsWith("//")) {
    const enc = encodeURIComponent(redirect);
    const btnLogin = document.getElementById("btn-login") as HTMLAnchorElement | null;
    const btnMock = document.getElementById("btn-mock") as HTMLAnchorElement | null;
    if (btnLogin) btnLogin.href = `/api/auth/login?redirect=${enc}`;
    if (btnMock) btnMock.href = `/api/auth/login?mock=1&redirect=${enc}`;
  }

  // 登录态感知：已登录 → 换成欢迎卡片；未配置正式凭据 → 显示演示登录入口
  fetch("/api/auth/me")
    .then((r) => (r.ok ? r.json() : null))
    .then((d) => {
      if (!d) return;
      const anonBox = document.getElementById("anon-box");
      const userBox = document.getElementById("user-box");
      if (d.authenticated) {
        anonBox?.setAttribute("hidden", "");
        userBox?.removeAttribute("hidden");
        (document.getElementById("user-name") as HTMLElement).textContent =
          d.user?.name || d.user?.account || "已登录";
        (document.getElementById("user-account") as HTMLElement).textContent =
          d.user?.account ? `（${d.user.account}）` : "";
        const typeEl = document.getElementById("user-type") as HTMLElement;
        if (d.user?.type) {
          typeEl.textContent = d.user.type === "student" ? "在校学生" : d.user.type;
          typeEl.removeAttribute("hidden");
        }
        if (d.user?.mock) (document.getElementById("user-mock") as HTMLElement).removeAttribute("hidden");
      } else if (!d.configured && d.mock_allowed) {
        (document.getElementById("mock-box") as HTMLElement).removeAttribute("hidden");
      }
    })
    .catch(() => {});
</script>

<style>
  .login-card {
    max-width: 560px;
    padding: 28px;
  }

  .btn-primary {
    display: inline-block;
    background: var(--red);
    color: #fff;
    font-weight: 600;
    padding: 10px 28px;
    border-radius: 8px;
    text-decoration: none;
  }

  .btn-primary:hover {
    background: var(--red-dark);
  }

  .btn-ghost {
    display: inline-block;
    border: 1px solid var(--border);
    color: var(--text-light);
    padding: 8px 22px;
    border-radius: 8px;
    text-decoration: none;
    margin-top: 8px;
  }

  .btn-ghost:hover {
    border-color: var(--red);
    color: var(--red);
  }

  #mock-box {
    margin-top: 20px;
  }

  #mock-box hr {
    border: none;
    border-top: 1px dashed var(--border);
    margin-bottom: 14px;
  }

  .login-welcome {
    font-size: 1.05rem;
    margin: 0 0 14px;
  }

  .login-welcome .badge {
    margin-left: 6px;
    vertical-align: 1px;
  }

  .login-faq {
    margin: 24px 0 0;
    padding-left: 18px;
    font-size: 0.88rem;
    line-height: 1.8;
  }
</style>
