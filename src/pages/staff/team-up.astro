---
export const prerender = false;

import PrivilegedLayout from "../../layouts/PrivilegedLayout.astro";
import TeamUpBody from "../../views/TeamUpBody.astro";
import { denyPrivilegedRequest } from "../../lib/site-gate";
import { features } from "../../config";

/* 页面临时下线对管理员视角同样生效（见 config.ts features.teamUpHidden） */
if (features.teamUpHidden) {
  return new Response("Not Found", { status: 404, headers: { "Content-Type": "text/plain; charset=utf-8" } });
}

const blocked = denyPrivilegedRequest(Astro);
if (blocked) return blocked;
---

<PrivilegedLayout view="staff" title="协调组队" description="协会协调组队服务介绍：组队规则与找队友流程。">
  <TeamUpBody base="/staff" />
</PrivilegedLayout>
