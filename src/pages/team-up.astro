---
import BaseLayout from "../layouts/BaseLayout.astro";
import { features, wechat, email } from "../config";

const rules = [
  { title: "每队不超过 3 人", desc: "数学建模竞赛标准队形为 3 人一队（部分赛事允许 1–3 人），队员须为同校学生。" },
  { title: "建议建模 + 编程 + 写作分工", desc: "建模手负责问题分析与模型构建，编程手负责算法实现与数据处理，写作手负责论文撰写与排版；实战中分工可交叉，但建议各有所长。" },
  { title: "同校组队", desc: "美赛、国赛等主流赛事要求队员来自同一所学校；跨校队友仅部分练兵赛事允许，报名前请核对赛事规则。" },
];
---

<BaseLayout title="协调组队" description="协会协调组队服务介绍：组队规则与找队友流程。">
  <h1 class="page-title">协调组队</h1>
  <p class="page-subtitle">找不到队友？协会帮你匹配建模、编程、写作搭档。</p>

  <section class="section">
    <h2 class="section-title">组队规则</h2>
    <div class="grid grid-3">
      {rules.map((r) => (
        <article class="card">
          <h3 style="margin-top: 0;">{r.title}</h3>
          <p class="muted" style="margin-bottom: 0;">{r.desc}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <h2 class="section-title">找队友流程预告</h2>
    <div class="card">
      <ol class="flow">
        <li><strong>发布意向</strong>：组队功能开放后，在站内提交你的擅长方向（建模/编程/写作）、目标赛事与联系方式。</li>
        <li><strong>浏览匹配</strong>：查看其他同学发布的组队帖，按方向与目标赛事互相匹配。</li>
        <li><strong>联系确认</strong>：自行联系沟通，确认组队后即可共同报名参赛。</li>
      </ol>
      <p class="muted">
        功能开放前，你也可以在协会公众号「{wechat}」后台留言，或发送邮件至
        <a href={`mailto:${email}`}>{email}</a> 咨询组队事宜。
      </p>
    </div>
  </section>

  <section class="section cta-section">
    {features.teamUpOpen ? (
      <a class="btn btn-primary btn-lg" href="/team-up">发布组队意向</a>
    ) : (
      <button class="btn btn-disabled btn-lg" disabled>暂未开放 · 请关注公众号通知</button>
    )}
  </section>
</BaseLayout>

<style>
  .flow {
    margin: 0;
    padding-left: 22px;
  }

  .flow li {
    margin: 10px 0;
  }

  .cta-section {
    text-align: center;
  }

  .btn-lg {
    padding: 14px 40px;
    font-size: 1.1rem;
  }
</style>
