---
import newsData from "../data/news.json";
import { sortNews, type NewsItem } from "../lib/data";

const groups: { key: NewsItem["category"]; label: string; badge: string; desc: string; days: number }[] = [
  { key: "notice", label: "通知", badge: "badge-blue", desc: "集训招募、校内赛与公示通知", days: 92 },
  { key: "activity", label: "动态", badge: "badge-gray", desc: "协会活动与招新动态", days: 366 },
];

const items = newsData.items as NewsItem[];

/** 保留策略：构建时按当天日期过滤（数据文件保持全量，历史条目到期自动不再展示） */
function withinDays(n: NewsItem, days: number): boolean {
  const t = Date.parse(n.date);
  return Number.isFinite(t) && Date.now() - t <= days * 24 * 3600 * 1000;
}

/** 历史推送封面配图（按标题关键字匹配） */
const coverMap: [RegExp, string][] = [
  [/校内赛/, "/images/img17.jpg"],
  [/招新啦/, "/images/img18.jpg"],
];
function coverOf(n: NewsItem): string | undefined {
  return coverMap.find(([re]) => re.test(n.title))?.[1];
}

---

  <h1 class="page-title">新闻动态</h1>
  <p class="page-subtitle">协会近期通知与活动动态；更早的内容请到公众号「SJTU数学建模」（ID: sjtumcm）查看历史消息。</p>

  {groups.map((g) => {
    const list = sortNews(items.filter((n) => n.category === g.key && withinDays(n, g.days)));
    if (list.length === 0) {
      return (
        <section class="section">
          <h2 class="section-title">
            {g.label} <small>{g.desc}</small>
          </h2>
          <p class="muted archive-hint">当前时间窗口内没有{g.label}，往期内容可在公众号历史消息里查看。</p>
        </section>
      );
    }
    return (
      <section class="section">
        <h2 class="section-title">
          {g.label} <small>{g.desc}</small>
        </h2>
        <div class="news-list">
          {list.map((n) => {
            const cover = coverOf(n);
            const showLink = Boolean(n.source_url);
            const showNote = Boolean(n.note) && !n.note!.includes("additional/");
            return (
              <article class="card news-item">
                <div class="news-body">
                  <div class="news-meta">
                    <time datetime={n.date}>{n.date}</time>
                    <span class={`badge ${g.badge}`}>{g.label}</span>
                    {n.pinned && <span class="badge badge-red">置顶</span>}
                    {n.tags.map((t) => <span class="tag">{t}</span>)}
                  </div>
                  <h3>{n.title}</h3>
                  <p class="summary">{n.summary}</p>
                  {(showLink || showNote) && (
                    <p class="source muted">
                      {showLink && (
                        <a href={n.source_url} target="_blank" rel="noopener noreferrer">查看原文 →</a>
                      )}
                      {showNote && <span>（{n.note}）</span>}
                    </p>
                  )}
                </div>
                {cover && (
                  <img class="news-cover" src={cover} alt={`${n.title}封面`} loading="lazy" />
                )}
              </article>
            );
          })}
        </div>
      </section>
    );
  })}

  <section class="section wechat-archive">
    <div class="card">
      <h2 class="section-title">往期内容归档</h2>
      <p class="summary">
        全部历史推送可在微信公众号<strong>「SJTU数学建模」</strong>（ID: sjtumcm）的历史消息中查看。
      </p>
    </div>
  </section>

<style>
  .wechat-archive .card {
    padding: 16px 20px;
  }
  .wechat-archive .summary {
    margin: 0;
    color: var(--text-light);
    font-size: 0.95rem;
  }
  .archive-hint {
    margin: 0;
    font-size: 0.92rem;
  }

  .news-list {
    display: grid;
    gap: 16px;
  }

  .news-item {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    justify-content: space-between;
  }

  .news-body {
    flex: 1;
    min-width: 0;
  }

  .news-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 0.85rem;
    color: var(--text-light);
  }

  .news-item h3 {
    margin: 8px 0 6px;
    font-size: 1.1rem;
  }

  .summary {
    margin: 0 0 8px;
    color: #444;
    font-size: 0.95rem;
  }

  .source {
    margin: 0;
  }

  .news-cover {
    width: 200px;
    border-radius: 8px;
    flex-shrink: 0;
    border: 1px solid var(--border);
  }

  @media (max-width: 640px) {
    .news-item {
      flex-direction: column;
    }

    .news-cover {
      width: 100%;
    }
  }
</style>
