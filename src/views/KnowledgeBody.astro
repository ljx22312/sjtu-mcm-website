---
import cumcmData from "../data/cumcm-curriculum.json";
import mcmData from "../data/mcm-curriculum.json";

interface Resource {
  type: "link" | "doc" | "attachment";
  name: string;
  url?: string;
  token?: string;
  size_kb?: number;
}

/** 与飞书「集训大表」A–H 列一一对应的一行 */
interface CourseItem {
  row: number;
  module: string;
  course_id: string;
  topic: string;
  series?: string;
  episode?: number;
  format: string;
  format_detail: string[];
  intro: string;
  contact: string;
  no_playback: boolean;
  resources: Resource[];
}

interface TrackDoc {
  source: { title: string; feishu: string; sheet: string };
  modules: { name: string; count: number }[];
  items: CourseItem[];
}

/** 系列课合并后的单集 */
interface Episode {
  row: number;
  episode: number;
  course_id: string;
  stage: string;
  intro: string;
  resources: Resource[];
}

/** 展示层条目：普通课程 / 系列课（合并为一行）/ 正式比赛时间线节点 */
interface DisplayItem {
  kind: "course" | "series" | "milestone";
  row: number;
  module: string;
  course_id: string;
  topic: string;
  format: string;
  format_detail: string[];
  intro: string;
  contact: string;
  no_playback: boolean;
  resources: Resource[];
  /** series：全部分集 */
  episodes?: Episode[];
}

interface Track {
  key: string;
  label: string;
  doc: TrackDoc;
  items: DisplayItem[];
  modules: { name: string; count: number }[];
}

/**
 * 源数据 → 展示条目：
 * - 同名 series 的连续行合并为一条，分集收入 episodes（表格里 31 行「第N集」刷屏的根治）
 * - 「正式比赛」模块标记为 milestone，走时间线渲染，日期全文可见不被截断
 */
/**
 * 系列首集（如 MCMA23-1）在源数据里没有 series/episode 字段（采集时只给续行打标），
 * 先回填：某行 topic 与紧随其后行的 series 同名且同模块 → 它是该系列第 1 集。
 */
function backfillSeries(items: CourseItem[]): CourseItem[] {
  const out = items.map((it) => ({ ...it }));
  for (let i = 0; i < out.length; i++) {
    const cur = out[i];
    if (cur.module === "正式比赛" || cur.series) continue;
    const next = out[i + 1];
    if (next?.series && next.series === cur.topic && next.module === cur.module) {
      cur.series = cur.topic;
      cur.episode = 1;
    }
  }
  return out;
}

function buildDisplay(doc: TrackDoc): DisplayItem[] {
  const out: DisplayItem[] = [];
  for (const it of backfillSeries(doc.items)) {
    if (it.module === "正式比赛") {
      out.push({
        kind: "milestone", row: it.row, module: it.module, course_id: it.course_id,
        topic: it.topic, format: it.format, format_detail: it.format_detail,
        intro: it.intro, contact: it.contact, no_playback: it.no_playback,
        resources: it.resources,
      });
      continue;
    }
    if (it.series) {
      const ep: Episode = {
        row: it.row,
        episode: it.episode ?? 0,
        course_id: it.course_id,
        stage: it.format,
        intro: it.intro,
        resources: it.resources,
      };
      const last = out[out.length - 1];
      if (last && last.kind === "series" && last.topic === it.series) {
        last.episodes!.push(ep);
        continue;
      }
      out.push({
        kind: "series", row: it.row, module: it.module, course_id: it.course_id,
        topic: it.series, format: "", format_detail: it.format_detail,
        intro: it.intro, contact: it.contact, no_playback: it.no_playback,
        // 行上只挂系列级材料（文档/附件）；每集的「回放」留在分集列表里
        resources: it.resources.filter((r) => r.name !== "回放"),
        episodes: [ep],
      });
      continue;
    }
    out.push({
      kind: "course", row: it.row, module: it.module, course_id: it.course_id,
      topic: it.topic, format: it.format, format_detail: it.format_detail,
      intro: it.intro, contact: it.contact, no_playback: it.no_playback,
      resources: it.resources,
    });
  }
  return out;
}

function withDisplayCounts(doc: TrackDoc, items: DisplayItem[]) {
  const counts = new Map<string, number>();
  for (const it of items) counts.set(it.module, (counts.get(it.module) ?? 0) + 1);
  return doc.modules.map((m) => ({ name: m.name, count: counts.get(m.name) ?? m.count }));
}

interface Props {
  /** 仅管理员视角传入。公开站和下一版本不传，页面上就不会出现这些板块。 */
  extraTracks?: { key: string; label: string; doc: TrackDoc }[];
}

const { extraTracks = [] } = Astro.props;

const trackDocs: { key: string; label: string; doc: TrackDoc }[] = [
  { key: "cumcm", label: "2026 国赛集训", doc: cumcmData as unknown as TrackDoc },
  { key: "mcm", label: "2026 美赛集训", doc: mcmData as unknown as TrackDoc },
  ...extraTracks,
];

const tracks: Track[] = trackDocs.map((t) => {
  const items = buildDisplay(t.doc);
  return { ...t, items, modules: withDisplayCounts(t.doc, items) };
});

/** 按原表顺序（模块列纵向合并）聚成分组 */
function groupsOf(items: DisplayItem[]) {
  const groups: { name: string; items: DisplayItem[] }[] = [];
  for (const it of items) {
    if (!groups.length || groups[groups.length - 1].name !== it.module) {
      groups.push({ name: it.module, items: [] });
    }
    groups[groups.length - 1].items.push(it);
  }
  return groups;
}

function askLabel(courseId: string, topic: string, episode?: number): string {
  const head = [courseId, topic].filter(Boolean).join(" ");
  return episode ? `${head} 第${episode}集` : head;
}

/** 系列课行的形式列 */
function seriesFormat(it: DisplayItem): string {
  return `${it.episodes!.length} 集系列`;
}

function searchText(it: DisplayItem): string {
  const parts = [
    it.module,
    it.course_id,
    it.topic,
    it.intro,
    it.contact,
    it.format,
    ...it.resources.map((r) => r.name),
  ];
  if (it.episodes) {
    for (const ep of it.episodes) {
      parts.push(ep.course_id, ep.stage, ep.intro, ...ep.resources.map((r) => r.name));
    }
  }
  return parts.filter(Boolean).join(" ").toLowerCase();
}
---

  <h1 class="page-title">知识库</h1>
  <p class="page-subtitle">
    {
      extraTracks.length > 0
        ? "集训课程大表，按模块分组，支持搜索与筛选。尚未公开的板块只在管理员视角。"
        : "两次集训的完整课程大表，与协会飞书集训表同构：按模块分组，支持搜索与筛选。"
    }
  </p>

  <!-- 集训批次 tab（对应两张飞书大表） -->
  <div class="tabs" id="track-tabs">
    {tracks.map((t, i) => (
      <button class:list={["tab", { active: i === 0 }]} data-track={t.key}>
        {t.label} <span class="tab-count">{t.items.length > 0 ? `${t.items.length} 条` : "待录入"}</span>
      </button>
    ))}
  </div>

  {tracks.map((t, i) => {
    if (t.items.length === 0) {
      return (
        <section class="track-panel" data-track-panel={t.key} data-unfilled="1" hidden={i !== 0}>
          <div class="card kb-unfilled">
            <p>{t.label}的课程还没有录入。这个板块只在管理员视角，课表确定后按集训大表补进来，公开知识库里不会出现。</p>
            <p class="muted">模块先按美赛集训的结构留好：</p>
            <ul class="kb-unfilled-modules">
              {t.modules.map((m) => <li>{m.name}</li>)}
            </ul>
          </div>
        </section>
      );
    }
    const groups = groupsOf(t.items);
    return (
      <section class="track-panel" data-track-panel={t.key} hidden={i !== 0}>
        <!-- 工具栏：搜索 + 模块筛选 + 计数 -->
        <div class="kb-toolbar">
          <input
            class="kb-search"
            type="search"
            placeholder="搜索课程 / 编号 / 关键词，可多词（空格分隔）…"
            aria-label="搜索课程"
          />
          <div class="kb-chips">
            <button class="chip active" data-module="">全部模块</button>
            {t.modules.map((m) => (
              <button class="chip" data-module={m.name}>
                {m.name}<span class="chip-cnt">{m.count}</span>
              </button>
            ))}
          </div>
          <span class="kb-count muted">
            显示 <b class="kb-count-num">{t.items.length}</b> / {t.items.length} 条
          </span>
        </div>

        <!-- 桌面端：分组数据表 -->
        <div class="kb-scroll">
          <table class="kb-table">
            <thead>
              <tr>
                <th class="c-id">编号</th>
                <th class="c-topic">主题</th>
                <th class="c-fmt">形式</th>
                <th class="c-intro">课程介绍</th>
                <th class="c-ct">联络人</th>
                <th class="c-res">资料与回放</th>
              </tr>
            </thead>
            <tbody>
              {groups.map((g, gi) => (
                <>
                  <tr class="kb-group" data-group={gi}>
                    <td colspan={6}>
                      <span class="g-name">{g.name}</span>
                      <span class="g-count">{g.items.length} 条</span>
                      {g.name === "正式比赛" && <span class="badge badge-gray">赛程时间线</span>}
                      {g.name === "赛题实战" && <span class="badge badge-gold">模拟实战</span>}
                    </td>
                  </tr>

                  {/* 正式比赛：时间线渲染，日期全文可见（原先放介绍列会被两行截断） */}
                  {g.name === "正式比赛" ? (
                    <tr class="kb-timeline kb-filter" data-group={gi} data-module={g.name} data-count={g.items.length} data-search={g.items.map(searchText).join(" ")}>
                      <td colspan={6}>
                        <ul class="tl">
                          {g.items.map((m) => (
                            <li class="tl-item">
                              <div class="tl-body">
                                <span class="tl-title">{m.topic}</span>
                                <span class="tl-time">{m.intro}</span>
                              </div>
                            </li>
                          ))}
                        </ul>
                      </td>
                    </tr>
                  ) : (
                    g.items.map((it) => (
                      <>
                        <tr
                          class="kb-row kb-filter"
                          data-module={it.module}
                          data-group={gi}
                          data-search={searchText(it)}
                          tabindex="0"
                          aria-expanded="false"
                        >
                          <td class="c-id">{it.course_id || "·"}</td>
                          <td class="c-topic">
                            {it.kind === "series" ? (
                              <label class="ask-pick">
                                <input type="checkbox" class="ask-all" data-series={`${t.key}:${it.row}`} aria-label={`选择${it.topic}的全部分集`} />
                              </label>
                            ) : (
                              <label class="ask-pick">
                                <input type="checkbox" class="ask-one" data-lecture-key={`${t.key}:${it.row}`} data-lecture-label={askLabel(it.course_id, it.topic)} aria-label={`选择${it.topic}`} />
                              </label>
                            )}
                            {it.topic}
                            {it.kind === "series" && (
                              <span class="badge badge-gray series-badge">{it.episodes!.length} 集</span>
                            )}
                          </td>
                          <td class="c-fmt">{it.kind === "series" ? seriesFormat(it) : it.format || "—"}</td>
                          <td class="c-intro">
                            {it.intro ? <span>{it.intro}</span> : <span class="muted">—</span>}
                          </td>
                          <td class="c-ct">{it.contact || "—"}</td>
                          <td class="c-res">
                            <div class="c-res-inner">
                              {it.resources.map((r) => (
                                r.url ? (
                                  <a class="res-link" href={r.url} target="_blank" rel="noopener noreferrer" title={r.name}>↗ {r.name}</a>
                                ) : r.type === "attachment" ? (
                                  <span class="res-att" title="飞书附件 · 仅协会成员可见">📎 {r.name}</span>
                                ) : (
                                  <span class="res-doc" title="飞书文档/材料 · 仅协会成员可见">{r.name}</span>
                                )
                              ))}
                              {it.kind === "series" && (
                                <span class="res-ep-hint">每集回放见展开</span>
                              )}
                              {it.resources.length === 0 && it.kind !== "series" && (it.no_playback
                                ? <span class="muted noplay">无回放</span>
                                : <span class="muted">—</span>)}
                            </div>
                          </td>
                        </tr>
                        <tr class="kb-detail" hidden>
                          <td colspan={6}>
                            <div class="detail-grid">
                              {(it.format || it.format_detail.length > 0) && (
                                <div class="d-row">
                                  <span class="d-dt">形式与安排</span>
                                  <span class="d-dd">{[it.format, ...it.format_detail].filter(Boolean).join("；")}</span>
                                </div>
                              )}
                              {it.intro && <div class="d-row"><span class="d-dt">课程介绍</span><span class="d-dd">{it.intro}</span></div>}
                              {it.contact && <div class="d-row"><span class="d-dt">联络人</span><span class="d-dd">{it.contact}</span></div>}
                              {it.resources.length > 0 && (
                                <div class="d-row">
                                  <span class="d-dt">资料</span>
                                  <span class="d-dd d-res">
                                    {it.resources.map((r) => (
                                      r.url ? (
                                        <a href={r.url} target="_blank" rel="noopener noreferrer">↗ {r.name}</a>
                                      ) : r.type === "attachment" ? (
                                        <span title="飞书附件 · 仅协会成员可见">📎 {r.name}</span>
                                      ) : (
                                        <span title="飞书文档/材料 · 仅协会成员可见">📄 {r.name}</span>
                                      )
                                    ))}
                                  </span>
                                </div>
                              )}
                              {it.kind === "series" && (
                                <div class="d-row">
                                  <span class="d-dt">分集</span>
                                  <ol class="ep-list">
                                    {it.episodes!.map((ep) => (
                                      <li>
                                        <label class="ask-pick">
                                          <input type="checkbox" class="ask-ep" data-series={`${t.key}:${it.row}`} data-lecture-key={`${t.key}:${ep.row}`} data-lecture-label={askLabel(ep.course_id, it.topic, ep.episode)} aria-label={`选择第${ep.episode}集`} />
                                        </label>
                                        <span class="ep-head">
                                          第 {ep.episode} 集{ep.stage ? ` · ${ep.stage}` : ""}
                                        </span>
                                        {ep.intro && <span class="ep-intro">{ep.intro}</span>}
                                        {ep.resources.filter((r) => r.url).map((r) => (
                                          <a href={r.url} target="_blank" rel="noopener noreferrer">↗ {r.name}</a>
                                        ))}
                                      </li>
                                    ))}
                                  </ol>
                                </div>
                              )}
                              {it.no_playback && <div class="d-row"><span class="d-dt">回放</span><span class="d-dd muted">无回放</span></div>}
                            </div>
                          </td>
                        </tr>
                      </>
                    ))
                  )}
                </>
              ))}
              <tr class="kb-empty" hidden><td colspan={6}>没有匹配的条目，换个关键词试试。</td></tr>
            </tbody>
          </table>
        </div>

        <!-- 移动端：卡片（原生 details，无 JS 也可展开），带模块分组标题 -->
        <div class="kb-cards">
          {groups.map((g, gi) => (
            <>
              <p class="kb-group-label" data-group-label={gi}>
                {g.name} <span>{g.items.length} 条</span>
              </p>
              {g.name === "正式比赛" ? (
                <details class="kb-card kb-filter-card" data-module={g.name} data-group={gi} data-count={g.items.length} data-search={g.items.map(searchText).join(" ")}>
                  <summary>
                    <span class="kb-card-topic">正式比赛 · 赛程时间线</span>
                  </summary>
                  <div class="kb-card-body">
                    <ul class="tl">
                      {g.items.map((m) => (
                        <li class="tl-item">
                          <div class="tl-body">
                            <span class="tl-title">{m.topic}</span>
                            <span class="tl-time">{m.intro}</span>
                          </div>
                        </li>
                      ))}
                    </ul>
                  </div>
                </details>
              ) : (
                g.items.map((it) => (
                  <details class="kb-card kb-filter-card" data-module={it.module} data-group={gi} data-search={searchText(it)}>
                    <summary>
                      {it.kind === "series" ? (
                        <label class="ask-pick">
                          <input type="checkbox" class="ask-all" data-series={`${t.key}:${it.row}`} aria-label={`选择${it.topic}的全部分集`} />
                        </label>
                      ) : (
                        <label class="ask-pick">
                          <input type="checkbox" class="ask-one" data-lecture-key={`${t.key}:${it.row}`} data-lecture-label={askLabel(it.course_id, it.topic)} aria-label={`选择${it.topic}`} />
                        </label>
                      )}
                      <span class="kb-card-id">{it.course_id || "·"}</span>
                      <span class="kb-card-topic">{it.topic}</span>
                      {it.kind === "series" ? (
                        <span class="kb-card-links">{it.episodes!.length} 集</span>
                      ) : it.resources.some((r) => r.url) ? (
                        <span class="kb-card-links">↗ {it.resources.filter((r) => r.url).length}</span>
                      ) : it.resources.length > 0 ? (
                        <span class="kb-card-atts">📎 {it.resources.length}</span>
                      ) : null}
                      <span class="kb-card-fmt">{it.kind === "series" ? seriesFormat(it) : it.format}</span>
                    </summary>
                    <div class="kb-card-body">
                      {(it.format || it.format_detail.length > 0) && (
                        <p class="muted">形式与安排：{[it.format, ...it.format_detail].filter(Boolean).join("；")}</p>
                      )}
                      {it.intro && <p>{it.intro}</p>}
                      {it.contact && <p class="muted">联络人：{it.contact}</p>}
                      {it.resources.length > 0 && (
                        <p class="kb-card-res">
                          {it.resources.map((r) => (
                            r.url ? (
                              <a href={r.url} target="_blank" rel="noopener noreferrer">↗ {r.name}</a>
                            ) : r.type === "attachment" ? (
                              <span title="飞书附件 · 仅协会成员可见">📎 {r.name}</span>
                            ) : (
                              <span title="飞书文档/材料 · 仅协会成员可见">📄 {r.name}</span>
                            )
                          ))}
                        </p>
                      )}
                      {it.kind === "series" && (
                        <ol class="ep-list">
                          {it.episodes!.map((ep) => (
                            <li>
                              <label class="ask-pick">
                                <input type="checkbox" class="ask-ep" data-series={`${t.key}:${it.row}`} data-lecture-key={`${t.key}:${ep.row}`} data-lecture-label={askLabel(ep.course_id, it.topic, ep.episode)} aria-label={`选择第${ep.episode}集`} />
                              </label>
                              <span class="ep-head">
                                第 {ep.episode} 集{ep.stage ? ` · ${ep.stage}` : ""}
                              </span>
                              {ep.intro && <span class="ep-intro">{ep.intro}</span>}
                              {ep.resources.filter((r) => r.url).map((r) => (
                                <a href={r.url} target="_blank" rel="noopener noreferrer">↗ {r.name}</a>
                              ))}
                            </li>
                          ))}
                        </ol>
                      )}
                      {it.no_playback && <p class="muted">无回放</p>}
                    </div>
                  </details>
                ))
              )}
            </>
          ))}
          <p class="kb-empty-cards muted" hidden>没有匹配的条目，换个关键词试试。</p>
        </div>

        <p class="kb-source muted">
          数据源：{t.doc.source.title}（飞书「{t.doc.source.sheet}」，{t.doc.source.feishu.replace("https://", "")}）
        </p>
      </section>
    );
  })}

  <div id="kb-ask-bar" hidden>
    <p id="kb-ask-count">未选择讲次</p>
    <button type="button" id="kb-ask-go">向助手提问</button>
    <button type="button" id="kb-ask-clear">清除</button>
  </div>

  <script>
    const tabs = document.querySelectorAll<HTMLElement>("#track-tabs .tab");
    const panels = document.querySelectorAll<HTMLElement>("[data-track-panel]");

    function setupPanel(panel: HTMLElement) {
      if (panel.dataset.unfilled === "1") return;
      // 表格侧可过滤元素：课程/系列行 + 正式比赛时间线行
      const filterEls = Array.from(panel.querySelectorAll<HTMLElement>(".kb-filter"));
      const cards = Array.from(panel.querySelectorAll<HTMLElement>(".kb-filter-card"));
      const groupRows = Array.from(panel.querySelectorAll<HTMLElement>(".kb-group"));
      const groupLabels = Array.from(panel.querySelectorAll<HTMLElement>("[data-group-label]"));
      const search = panel.querySelector<HTMLInputElement>(".kb-search")!;
      const chips = Array.from(panel.querySelectorAll<HTMLElement>(".kb-chips .chip"));
      const countNum = panel.querySelector<HTMLElement>(".kb-count-num")!;
      const emptyRow = panel.querySelector<HTMLElement>(".kb-empty");
      const emptyCards = panel.querySelector<HTMLElement>(".kb-empty-cards");
      const cardsWrap = panel.querySelector<HTMLElement>(".kb-cards");
      let module = "";

      // 多词搜索：空格分词，每个词都要命中
      function tokens(): string[] {
        return search.value.trim().toLowerCase().split(/\s+/).filter(Boolean);
      }

      function applyFilter() {
        const ts = tokens();
        const match = (el: HTMLElement) =>
          (!module || el.dataset.module === module) &&
          (ts.length === 0 || ts.every((t) => (el.dataset.search ?? "").includes(t)));

        const itemCount = (el: HTMLElement) => {
          const n = Number(el.dataset.count);
          return Number.isFinite(n) && n > 0 ? n : 1;
        };
        let tableVisible = 0;
        const groupVisible = new Map<number, number>();
        for (const el of filterEls) {
          const ok = match(el);
          el.style.display = ok ? "" : "none";
          if (ok) {
            tableVisible += itemCount(el);
            const gi = Number(el.dataset.group ?? -1);
            if (gi >= 0) groupVisible.set(gi, (groupVisible.get(gi) ?? 0) + 1);
          }
          // 被过滤掉的展开行同时收起详情行
          if (el.classList.contains("kb-row")) {
            const next = el.nextElementSibling as HTMLElement | null;
            if (!ok && next?.classList.contains("kb-detail")) next.hidden = true;
            el.setAttribute("aria-expanded", "false");
          }
        }

        let cardVisible = 0;
        const cardGroupVisible = new Map<number, number>();
        for (const el of cards) {
          const ok = match(el);
          el.style.display = ok ? "" : "none";
          if (ok) {
            cardVisible += itemCount(el);
            const gi = Number(el.dataset.group ?? -1);
            if (gi >= 0) cardGroupVisible.set(gi, (cardGroupVisible.get(gi) ?? 0) + 1);
          }
        }

        for (const gr of groupRows) {
          const n = groupVisible.get(Number(gr.dataset.group)) ?? 0;
          gr.style.display = n > 0 ? "" : "none";
        }
        for (const gl of groupLabels) {
          const n = cardGroupVisible.get(Number(gl.dataset.groupLabel)) ?? 0;
          gl.style.display = n > 0 ? "" : "none";
        }

        // 计数器只统计当前视口实际可见的那套渲染：移动端（≤860px）卡片容器为 grid 布局
        const isMobile = cardsWrap ? getComputedStyle(cardsWrap).display === "grid" : filterEls.length === 0;
        countNum.textContent = String(isMobile ? cardVisible : tableVisible);
        if (emptyRow) emptyRow.hidden = isMobile || tableVisible > 0;
        if (emptyCards) emptyCards.hidden = !isMobile || cardVisible > 0;
      }

      // 行点击 / 键盘展开详情
      panel.querySelectorAll<HTMLElement>(".kb-row").forEach((row) => {
        const toggle = () => {
          const detail = row.nextElementSibling as HTMLElement | null;
          if (!detail?.classList.contains("kb-detail")) return;
          const open = detail.hidden;
          detail.hidden = !open;
          row.setAttribute("aria-expanded", String(open));
        };
        row.addEventListener("click", (e) => {
          const target = e.target as HTMLElement;
          if (target.closest("a, .ask-pick")) return;
          toggle();
        });
        row.addEventListener("keydown", (e) => {
          if ((e.target as HTMLElement).closest(".ask-pick")) return;
          if (e.key === "Enter" || e.key === " ") {
            e.preventDefault();
            toggle();
          }
        });
      });

      search.addEventListener("input", applyFilter);

      // 视口跨越桌面表格 / 移动卡片断点（860px）后重新计数
      window.addEventListener("resize", applyFilter);

      panel.querySelector(".kb-chips")?.addEventListener("click", (e) => {
        const chip = (e.target as HTMLElement).closest(".chip") as HTMLElement | null;
        if (!chip) return;
        module = chip.dataset.module ?? "";
        chips.forEach((c) => c.classList.toggle("active", c === chip));
        applyFilter();
      });
    }

    panels.forEach(setupPanel);

    tabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        tabs.forEach((t) => t.classList.toggle("active", t === tab));
        panels.forEach((p) => (p.hidden = p.dataset.trackPanel !== tab.dataset.track));
      });
    });

    const SCOPE_KEY = "sjtumcm-lecture-scope";
    const askBar = document.getElementById("kb-ask-bar");
    const askCount = document.getElementById("kb-ask-count");
    type Pick = { key: string; label: string };

    function readStored(): Pick[] {
      try {
        const raw = JSON.parse(localStorage.getItem(SCOPE_KEY) || "[]");
        if (!Array.isArray(raw)) return [];
        return raw.filter((item) => item && typeof item.key === "string" && typeof item.label === "string");
      } catch {
        return [];
      }
    }

    function selectedPicks(): Pick[] {
      const seen = new Set<string>();
      const picks: Pick[] = [];
      document.querySelectorAll<HTMLInputElement>(".ask-one:checked, .ask-ep:checked").forEach((box) => {
        const key = box.dataset.lectureKey || "";
        const label = box.dataset.lectureLabel || key;
        if (!key || seen.has(key)) return;
        seen.add(key);
        picks.push({ key, label });
      });
      return picks;
    }

    function paintAsk(picks: Pick[]) {
      if (askBar && askCount) {
        askBar.hidden = picks.length === 0;
        askCount.textContent = picks.length === 0 ? "未选择讲次" : `已选 ${picks.length} 讲：${picks.map((p) => p.label).slice(0, 3).join("、")}${picks.length > 3 ? "…" : ""}`;
      }
    }

    function storeAsk(picks: Pick[]) {
      localStorage.setItem(SCOPE_KEY, JSON.stringify(picks));
      paintAsk(picks);
      window.dispatchEvent(new CustomEvent("agent-lectures", { detail: picks }));
    }

    function syncBoxes(picks: Pick[]) {
      const keys = new Set(picks.map((p) => p.key));
      document.querySelectorAll<HTMLInputElement>(".ask-one, .ask-ep").forEach((box) => {
        box.checked = keys.has(box.dataset.lectureKey || "");
      });
      document.querySelectorAll<HTMLInputElement>(".ask-all").forEach((master) => {
        const series = master.dataset.series || "";
        const eps = [...document.querySelectorAll<HTMLInputElement>(`.ask-ep[data-series="${series}"]`)];
        master.checked = eps.length > 0 && eps.every((box) => box.checked);
      });
    }

    document.querySelectorAll<HTMLInputElement>(".ask-one, .ask-ep").forEach((box) => {
      box.addEventListener("change", () => storeAsk(selectedPicks()));
      box.addEventListener("click", (e) => e.stopPropagation());
    });
    document.querySelectorAll<HTMLInputElement>(".ask-all").forEach((master) => {
      master.addEventListener("click", (e) => e.stopPropagation());
      master.addEventListener("change", () => {
        const series = master.dataset.series || "";
        document.querySelectorAll<HTMLInputElement>(`.ask-ep[data-series="${series}"]`).forEach((box) => {
          box.checked = master.checked;
        });
        storeAsk(selectedPicks());
      });
    });
    document.querySelectorAll<HTMLLabelElement>(".ask-pick").forEach((label) => {
      label.addEventListener("pointerdown", (e) => e.stopPropagation());
      label.addEventListener("click", (e) => e.stopPropagation());
    });

    const initial = readStored();
    syncBoxes(initial);
    paintAsk(initial);
    window.addEventListener("agent-lectures", (e) => {
      const picks = (e as CustomEvent<Pick[]>).detail || [];
      syncBoxes(picks);
      paintAsk(picks);
    });
    document.getElementById("kb-ask-clear")?.addEventListener("click", () => {
      document.querySelectorAll<HTMLInputElement>(".ask-one, .ask-ep, .ask-all").forEach((box) => {
        box.checked = false;
      });
      storeAsk([]);
    });
    document.getElementById("kb-ask-go")?.addEventListener("click", () => {
      storeAsk(selectedPicks());
      window.dispatchEvent(new CustomEvent("agent-open"));
    });
  </script>

