  }

  async function openSettings(): Promise<void> {
    if (!ready) {
      await openPanel();
      if (!ready) return;
    }
    /* 回填自带 API 表单 */
    const c = customMem;
    customBaseUrl.value = c?.baseUrl ?? "";
    customKey.value = c?.apiKey ?? "";
    customModel.value = c?.model ?? "";
    customReasoning.value = c?.reasoning ?? "medium";
    setHint(customStatus, "");
    /* 拉取官方参数 + 管理员身份；管理员才渲染控制区块 */
    adminSection.hidden = true;
    setHint(adminStatus, "");
    try {
      const res = await fetch("/api/agent/settings");
      if (res.ok) {
        const data = await res.json();
        if (data.admin) {
          adminModel.value = data.officialModel ?? "";
          if (adminReasoning.options.length === 0) {
            for (const r of data.reasoningLevels ?? []) {
              const opt = document.createElement("option");
              opt.value = r.value;
              opt.textContent = r.label;
              adminReasoning.appendChild(opt);
            }
          }
          adminReasoning.value = data.officialReasoning ?? "medium";
          adminSection.hidden = false;
        }
      }
    } catch {
      /* 网络异常不阻塞设置页打开，仅管理员区块不可用 */
    }
    settingsView.hidden = false;
  }

  function hideSettings(): void {
