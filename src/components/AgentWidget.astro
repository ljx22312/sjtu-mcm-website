  /* ---------- 输入 ---------- */

  function autoGrow() {
    const cap = widget.classList.contains("is-fullscreen") ? 220 : 110;
    input.style.height = "auto";
    input.style.height = `${Math.min(input.scrollHeight, cap)}px`;
  }
  input.addEventListener("input", autoGrow);
  input.addEventListener("keydown", (e) => {
    if (e.key === "Enter" && !e.shiftKey) {
      e.preventDefault();
      send();
    }
  });
  sendBtn.addEventListener("click", () => {
    if (streaming) stopStreaming();
    else void send();
  });

  function setStreaming(on: boolean) {
    streaming = on;
    input.disabled = on;
    sendBtn.classList.toggle("is-stop", on);
    sendBtn.setAttribute("aria-label", on ? "停止生成" : "发送");
    sendBtn.innerHTML = on ? STOP_ICON : SEND_ICON;
  }

  const SCOPE_KEY = "sjtumcm-lecture-scope";
  const scopeBar = document.getElementById("agent-scope");

  function lecturePicks(): { key: string; label: string }[] {
    try {
      const raw = JSON.parse(localStorage.getItem(SCOPE_KEY) || "[]");
      if (!Array.isArray(raw)) return [];
      return raw.filter((item) => item && typeof item.key === "string" && /^(cumcm|mcm):\d+$/.test(item.key));
    } catch {
      return [];
    }
  }

  function lectureKeys(): string[] {
    return lecturePicks().map((item) => item.key);
  }

  function renderScope(picks = lecturePicks()) {
    if (!scopeBar) return;
    scopeBar.innerHTML = "";
    if (picks.length === 0) {
      scopeBar.hidden = !document.getElementById("kb-ask-bar");
      if (!scopeBar.hidden) scopeBar.textContent = "在课程表里勾选要提问的讲";
      return;
    }
    scopeBar.hidden = false;
    for (const pick of picks) {
      const chip = document.createElement("button");
      chip.type = "button";
      chip.className = "agent-scope-chip";
      chip.textContent = `${pick.label} ×`;
      chip.title = "移出这一讲";
      chip.addEventListener("click", () => {
        const next = lecturePicks().filter((item) => item.key !== pick.key);
        localStorage.setItem(SCOPE_KEY, JSON.stringify(next));
        renderScope(next);
        window.dispatchEvent(new CustomEvent("agent-lectures", { detail: next }));
      });
      scopeBar.appendChild(chip);
    }
  }

  function mountCitations(
    bubble: HTMLElement,
    items: { n: number; title: string; locator: string; quote: string; url: string }[],
  ) {
    bubble.querySelector(".agent-cites")?.remove();
    if (items.length === 0) return;
    const box = document.createElement("div");
    box.className = "agent-cites";
    for (const item of items) {
      const button = document.createElement("button");
      button.type = "button";
      button.className = "agent-cite";
      button.dataset.n = String(item.n);
      const where = item.locator ? ` · ${item.locator}` : "";
      button.textContent = `[${item.n}] ${item.title}${where}`;
      const quote = document.createElement("blockquote");
      quote.className = "agent-cite-quote";
      quote.dataset.n = String(item.n);
      quote.hidden = true;
      quote.textContent = item.quote;
      if (item.url) {
        const link = document.createElement("a");
        link.href = item.url;
        link.target = "_blank";
        link.rel = "noopener noreferrer";
        link.textContent = "打开原链接";
        quote.appendChild(document.createElement("br"));
        quote.appendChild(link);
      }
      button.addEventListener("click", () => {
        quote.hidden = !quote.hidden;
      });
      box.appendChild(button);
      box.appendChild(quote);
    }
    bubble.appendChild(box);
  }

  renderScope();
  window.addEventListener("agent-lectures", () => renderScope());
  window.addEventListener("agent-open", () => {
    void openPanel();
  });

  async function send() {
    const text = input.value.trim();
    if (!text || streaming) return;
    if (!ready) {
      await openPanel();
      if (!ready) return;
    }
    input.value = "";
    autoGrow();
    const gen = ++turnGen;
    const turn = `t${++localTurn}`;
    const userEl = addMsg("user", text);
    userEl.dataset.turn = turn;
    userEl.dataset.plain = text;
    attachActions(userEl, "user");

    abortCtrl = new AbortController();
    setStreaming(true);
    const usingCustom = customMem !== null;
    let bubble: HTMLElement | null = null;
    let status: HTMLElement | null = null;
    let think: ThinkBlock | null = null;
    let thinkingDone = false;
    let acc = "";
    /* 服务端检测到本轮回答撞上模型输出上限（stop_reason 为 max_tokens 类） */
    let truncated = false;
    let cites: { n: number; title: string; locator: string; quote: string; url: string }[] = [];
    try {
      const res = await fetch("/api/agent/chat", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          message: text,
          sessionId: currentSessionId ?? undefined,
          /* 自带 API 配置随请求携带（仅 HTTPS 端点），服务端不落盘 */
          ...(usingCustom ? { custom: customMem } : {}),
          lectures: lectureKeys(),
        }),
        signal: abortCtrl.signal,
      });
      if (res.status === 401) {
        ready = false;
        addMsg("error", "登录已过期，请重新登录后使用。");
        showLoginPrompt();
        return;
      }
      if (res.status === 403) {
        const data = await res.json().catch(() => null as unknown as { error?: string } | null);
        addMsg("error", data?.error === "blocked" ? "这个账号的助手使用权限已被暂停，如有疑问请联系协会。" : "没有使用权限。");
        return;
      }
      if (res.status === 429) {
        const data = await res.json().catch(() => null as unknown as { error?: string } | null);
        if (data?.error === "blocked") {
          addMsg("error", "这个账号的助手使用权限已被暂停，如有疑问请联系协会。");
          return;
        }
        addMsg(
          "error",
          usingCustom ? "提问太频繁啦，请一小时后再试。" : "当前时段的提问上限到了，请稍后再试；也可在「模型设置」里配置自己的 API 继续使用。",
        );
        return;
      }
      if (res.status === 400) {
        const data = await res.json().catch(() => null as unknown as { error?: string } | null);
        addMsg("error", data?.error ? `自带 API 配置无效：${data.error}` : "请求无效，请检查「模型设置」。");
        return;
      }
      if (!res.ok || !res.body) {
        addMsg("error", "服务暂不可用，请稍后再试。");
        return;
      }

      const reader = res.body.getReader();
      const decoder = new TextDecoder();
      let buf = "";
      let streamFinished = false;
      for (;;) {
        const { done, value } = await reader.read();
        if (done) break;
        buf += decoder.decode(value, { stream: true });
        const parts = buf.split("\n\n");
        buf = parts.pop() ?? "";
        for (const part of parts) {
          const line = part.split("\n").find((l) => l.startsWith("data: "));
          if (!line) continue;
          let ev: any;
          try {
            ev = JSON.parse(line.slice(6));
          } catch {
            continue;
          }
          if (gen !== turnGen) continue;
          if (ev.type === "session") {
            /* 服务端分配/确认本场会话 id。过期的生成不能把编号写回来。 */
            if (typeof ev.sessionId === "number") {
              currentSessionId = ev.sessionId;
              rememberSession(currentSessionId);
            }
          } else if (ev.type === "user") {
            if (typeof ev.messageId === "number") {
              userEl.dataset.messageId = String(ev.messageId);
              userEl.dataset.retractId = String(ev.messageId);
            }
          } else if (ev.type === "thinking") {
            /* 思考流：懒建折叠块，正文出现前保持展开滚动 */
            if (!think) think = makeThinkBlock(true);
            appendThinking(think, ev.text);
          } else if (ev.type === "delta") {
            /* 第一个正文 token 到达：收起思考块 */
            if (think && !thinkingDone) {
              collapseThinking(think);
              thinkingDone = true;
            }
            acc += ev.text;
            if (status) {
              status.remove();
              status = null;
            }
            if (!bubble) {
              bubble = addMsg("assistant", "");
              bubble.dataset.turn = turn;
              bubble.addEventListener("click", (e) => {
                const ref = (e.target as HTMLElement).closest(".cite-ref") as HTMLElement | null;
                if (!ref) return;
                const quote = bubble?.querySelector(`.agent-cite-quote[data-n="${ref.dataset.n}"]`) as HTMLElement | null;
                if (quote) quote.hidden = !quote.hidden;
              });
            }
            bubble.dataset.plain = acc;
            bubble.innerHTML = renderRich(acc);
            mountCitations(bubble, cites);
            scrollBottom();
          } else if (ev.type === "citations" && Array.isArray(ev.items)) {
            cites = ev.items;
            if (bubble) mountCitations(bubble, cites);
          } else if (ev.type === "truncated") {
            /* 回答以 max_tokens 类原因结束：done 之前先标记，done 时在该条回答下提示 */
            truncated = true;
          } else if (ev.type === "tool") {
            const toolLabel =
              ev.name === "read_image"
                ? "正在查看图片…"
                : ev.name === "web_search"
                  ? "正在搜索公开网页…"
                  : ev.name === "read_lecture"
                    ? "正在阅读资料…"
                    : ev.name === "search_lectures"
                      ? "正在查阅知识库…"
                      : "正在检索课程表…";
            if (!status) status = addMsg("status", toolLabel);
            else status.textContent = toolLabel;
          } else if (ev.type === "done") {
            if (bubble) {
              bubble.dataset.plain = acc || bubble.dataset.plain || "";
              bubble.dataset.retractId = userEl.dataset.retractId || "";
              if (typeof ev.messageId === "number") bubble.dataset.messageId = String(ev.messageId);
              mountCitations(bubble, cites);
              attachActions(bubble, "assistant");
            }
            if (think) think.root.dataset.turn = turn;
            if (truncated) {
              const tip = addMsg(
                "status",
                "回答达到模型输出上限，可能在句中被截断。可以让我换个角度继续，或缩小问题范围。",
              );
              tip.dataset.turn = turn;
            } else if (ev.timeout) {
              /* 服务端回合总超时：按停止收尾，已生成内容保留 */
              const tip = addMsg("status", "本轮用时较长，已自动停止；已生成的内容保留，可以继续提问。");
              tip.dataset.turn = turn;
            }
            streamFinished = true;
          } else if (ev.type === "error") {
            addMsg("error", ev.message ?? "出错了，请稍后重试。");
            streamFinished = true;
          }
        }
        if (streamFinished) break;
      }
      /* done/error 已到：立即收尾并放开输入框，不等服务器关闭连接（防 SSE 悬挂拖住输入） */
      try {
        await reader.cancel();
      } catch {
        /* 连接已在关闭 */
      }
    } catch (err) {
      if (err instanceof DOMException && err.name === "AbortError") {
        if (bubble && !acc) {
          bubble.textContent = "（已停止）";
          bubble.dataset.plain = "（已停止）";
        }
        if (bubble) {
          bubble.dataset.retractId = userEl.dataset.retractId || "";
          attachActions(bubble, "assistant");
        }
        if (think) think.root.dataset.turn = turn;
      } else if (gen === turnGen) {
        addMsg("error", "网络异常，请稍后重试。");
      }
    } finally {
      if (think && !thinkingDone) collapseThinking(think); /* 无正文（异常）也收起 */
      if (status) status.remove();
      if (gen === turnGen) setStreaming(false);
      input.focus();
    }
  }
</script>
