---
/**
 * 右下角 agent 悬浮球 + 聊天面板（纯浏览器脚本，无前端框架依赖）。
 * 需登录（jAccount）：未登录时打开面板即显示登录引导，登录后回到当前页。
 *
 * 样式注意：消息气泡由 JS 动态创建，拿不到 Astro 作用域 cid 属性，
 * 因此这里必须用 is:global，选择器统一挂在 #agent-widget 下避免泄漏。
 */
---

<div id="agent-widget">
  <section id="agent-panel" hidden aria-label="智能助手对话面板">
    <header class="agent-head">
      <div class="agent-head-info">
        <h3>数模小助手</h3>
      </div>
      <div class="agent-head-actions">
        <button type="button" id="agent-settings" title="模型设置（自带 API / 思考深度）" aria-label="模型设置">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51 1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09a1.65 1.65 0 0 0 1.51-1 1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33h.01a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51h.01a1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82v.01a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
        </button>
        <button type="button" id="agent-history" title="历史对话（恢复之前的话题）" aria-label="历史对话">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 8v4l3 3"/><circle cx="12" cy="12" r="9"/></svg>
        </button>
        <button type="button" id="agent-clear" title="重新开始一段新对话" aria-label="重新开始">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M8 6V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2m3 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6h14z"/></svg>
        </button>
        <button type="button" id="agent-expand" title="全屏交流" aria-label="全屏交流" aria-pressed="false">
          <svg class="icon-expand" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3H5a2 2 0 0 0-2 2v3"/><path d="M21 8V5a2 2 0 0 0-2-2h-3"/><path d="M3 16v3a2 2 0 0 0 2 2h3"/><path d="M16 21h3a2 2 0 0 0 2-2v-3"/></svg>
          <svg class="icon-collapse" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v3a2 2 0 0 1-2 2H3"/><path d="M21 8h-3a2 2 0 0 1-2-2V3"/><path d="M3 16h3a2 2 0 0 1 2 2v3"/><path d="M16 21v-3a2 2 0 0 1 2-2h3"/></svg>
        </button>
        <button type="button" id="agent-close" title="收起面板" aria-label="收起面板">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </header>
    <div id="agent-body">
      <p class="agent-notice">每个人的对话分开保存。撤回后不再进入上下文，原文仍留在服务器。</p>
    </div>
    <div id="agent-sessions" hidden aria-label="历史对话列表">
      <div class="agent-sessions-head">
        <button type="button" id="agent-sessions-back" aria-label="返回对话">‹ 返回</button>
        <span>历史对话</span>
      </div>
      <div id="agent-sessions-list"></div>
    </div>
    <div id="agent-settings-view" hidden aria-label="模型设置">
      <div class="agent-sessions-head">
        <button type="button" id="agent-settings-back" aria-label="返回对话">‹ 返回</button>
        <span>模型设置</span>
      </div>
      <div id="agent-settings-body">
        <section class="agent-set-section">
          <h4>自带 API（可选）</h4>
          <p class="agent-set-desc">填写后对话改用你自己的模型额度，协会的 Key 与限额不再适用。配置仅保存在本浏览器（localStorage），不会上传到协会服务器。</p>
          <div id="agent-custom-form">
            <label class="agent-set-field">
              <span>API 地址（https:// 开头，Anthropic 协议）</span>
              <input type="url" id="agent-custom-baseurl" placeholder="https://open.bigmodel.cn/api/anthropic" autocomplete="off" spellcheck="false">
            </label>
            <label class="agent-set-field">
              <span>API Key</span>
              <input type="password" id="agent-custom-key" placeholder="sk-…" autocomplete="off">
            </label>
            <label class="agent-set-field">
              <span>模型 ID</span>
              <input type="text" id="agent-custom-model" placeholder="glm-4.6" autocomplete="off" spellcheck="false">
            </label>
            <label class="agent-set-field">
              <span>思考深度</span>
              <select id="agent-custom-reasoning">
                <option value="off">关闭（最快）</option>
                <option value="minimal">极浅</option>
                <option value="low">快速</option>
                <option value="medium" selected>标准</option>
                <option value="high">深度（最慢最贵）</option>
              </select>
            </label>
            <div class="agent-set-actions">
              <button type="button" id="agent-custom-save" class="agent-set-btn primary">保存</button>
              <button type="button" id="agent-custom-clear" class="agent-set-btn">清除自带 API</button>
            </div>
            <p class="agent-set-hint" id="agent-custom-status" hidden></p>
          </div>
        </section>
        <section class="agent-set-section" id="agent-admin-section" hidden>
          <h4>官方模型参数（仅管理员可见）</h4>
          <p class="agent-set-desc">对所有使用协会官方模型用户的生效配置，保存在服务器 data/agent-admin.json。</p>
          <label class="agent-set-field">
            <span>模型 ID</span>
            <input type="text" id="agent-admin-model" autocomplete="off" spellcheck="false">
          </label>
          <label class="agent-set-field">
            <span>思考深度</span>
            <select id="agent-admin-reasoning"></select>
          </label>
          <div class="agent-set-actions">
            <button type="button" id="agent-admin-save" class="agent-set-btn primary">保存官方参数</button>
          </div>
          <p class="agent-set-hint" id="agent-admin-status" hidden></p>
        </section>
      </div>
    </div>
    <div id="agent-scope" hidden></div>
    <footer class="agent-input">
      <textarea id="agent-input" rows="1" placeholder="问问我：国赛集训的论文写作课在哪看回放？"></textarea>
      <button type="button" id="agent-send" aria-label="发送">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 2-7 20-4-9-9-4z"/><path d="M22 2 11 13"/></svg>
      </button>
    </footer>
  </section>

  <button type="button" id="agent-fab" aria-label="打开智能助手" title="智能助手">
    <svg id="agent-fab-icon" viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
  </button>
</div>

<style is:global>
  #agent-widget {
    position: fixed;
    right: 20px;
    bottom: 20px;
    z-index: 999;
    font-size: 0.92rem;
    --agent-accent: var(--red, #cc0000);
    /* 消息气泡配色：用户浅红橙底黑字，助手浅蓝底黑字（微信式） */
    --agent-user-bg: #ffe3d3;
    --agent-user-color: #1f1f1f;
    --agent-bot-bg: #dceafa;
    --agent-bot-color: #1f1f1f;
  }

  /* 悬浮球 */
  #agent-fab {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 54px;
    height: 54px;
    margin-left: auto;
    border: none;
    border-radius: 50%;
    background: var(--agent-accent);
    color: #fff;
    cursor: pointer;
    box-shadow: 0 4px 16px rgba(204, 0, 0, 0.35);
    transition: transform 0.15s ease, background 0.15s ease;
  }
  #agent-fab:hover {
    background: var(--red-dark, #a30000);
    transform: translateY(-2px);
  }

  /* 面板 */
  #agent-panel {
    position: absolute;
    right: 0;
    bottom: 68px;
    width: min(380px, calc(100vw - 40px));
    height: min(560px, calc(100vh - 120px));
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--card-bg, #fff);
    border: 1px solid var(--border, #e5e5e5);
    border-radius: var(--radius, 10px);
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.18);
  }
  /* display:flex 会覆盖 hidden 属性的默认 display:none，必须显式压制，
     否则面板初始即打开、点 × 也关不掉 */
  #agent-panel[hidden] {
    display: none !important;
  }

  /* 全屏：铺满视口，对话列居中，方便长问答 */
  #agent-expand .icon-collapse {
    display: none;
  }
  #agent-widget.is-fullscreen #agent-expand .icon-expand {
    display: none;
  }
  #agent-widget.is-fullscreen #agent-expand .icon-collapse {
    display: block;
  }
  #agent-widget.is-fullscreen #agent-fab {
    display: none;
  }
  #agent-widget.is-fullscreen #agent-panel {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    height: 100dvh;
    border: none;
    border-radius: 0;
    box-shadow: none;
  }
  #agent-widget.is-fullscreen #agent-body,
  #agent-widget.is-fullscreen .agent-input {
    padding-left: max(16px, calc((100% - 880px) / 2));
    padding-right: max(16px, calc((100% - 880px) / 2));
  }
  #agent-widget.is-fullscreen #agent-body {
    padding-top: 20px;
    padding-bottom: 20px;
    gap: 14px;
  }
  #agent-widget.is-fullscreen .agent-msg {
    max-width: min(78%, 680px);
    font-size: 1rem;
  }
  #agent-widget.is-fullscreen #agent-input {
    max-height: 220px;
    font-size: 1rem;
  }
  html.agent-fullscreen-lock,
  html.agent-fullscreen-lock body {
    overflow: hidden;
  }

  .agent-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 14px;
    background: var(--agent-accent);
    color: #fff;
  }
  .agent-head-info h3 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.3;
  }
  .agent-head-info p {
    margin: 2px 0 0;
    font-size: 0.75rem;
    opacity: 0.85;
  }
  .agent-mode-badge {
    font-size: 0.68rem;
    line-height: 1.4;
  }
  .agent-head-actions {
    display: flex;
    gap: 4px;
  }
  .agent-head-actions button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    padding: 0;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: #fff;
    cursor: pointer;
    opacity: 0.85;
  }
  .agent-head-actions button:hover {
    background: rgba(255, 255, 255, 0.15);
    opacity: 1;
  }

  #agent-body {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    background: var(--bg, #fafafa);
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .agent-notice {
    margin: 0;
    font-size: 0.72rem;
    color: var(--text-light, #666);
    text-align: center;
  }

  /* 历史恢复分隔提示：打开面板时若拉到历史记录，插在正文最前 */
  .agent-resume {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 2px 0;
    font-size: 0.72rem;
    color: var(--text-light, #666);
    white-space: nowrap;
  }
  .agent-resume::before,
  .agent-resume::after {
    content: "";
    flex: 1;
    border-top: 1px solid var(--border, #e5e5e5);
  }

  /* 消息气泡（微信式双色） */
  .agent-msg {
    max-width: 86%;
    padding: 8px 12px;
    border-radius: 10px;
    line-height: 1.6;
    word-break: break-word;
    white-space: normal;
  }
  .agent-msg.user {
    align-self: flex-end;
    background: var(--agent-user-bg);
    color: var(--agent-user-color);
    border-bottom-right-radius: 3px;
  }
  .agent-msg.assistant {
    align-self: flex-start;
    background: var(--agent-bot-bg);
    color: var(--agent-bot-color);
    border-bottom-left-radius: 3px;
  }
  .agent-msg a {
    color: var(--blue, #1f4e9c);
    word-break: break-all;
  }
  .agent-msg.status {
    align-self: flex-start;
    font-size: 0.75rem;
    color: var(--text-light, #666);
    background: transparent;
    border: none;
    padding: 0 4px;
  }
  .agent-msg.error {
    align-self: flex-start;
    color: #a30000;
    background: #fdf0f0;
    border: 1px solid #f2caca;
  }

  /* 思考折叠块：挂在助手消息上方，流式时展开、正文出现后收起为摘要行 */
  .agent-think {
    align-self: flex-start;
    width: 86%;
    font-size: 0.78rem;
    color: var(--text-light, #666);
  }
  .agent-think-toggle {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 3px 8px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 999px;
    background: var(--card-bg, #fff);
    color: var(--text-light, #666);
    font-size: 0.72rem;
    cursor: pointer;
    user-select: none;
  }
  .agent-think-toggle:hover {
    color: var(--text, #333);
    border-color: #ccc;
  }
  .agent-think-toggle .agent-think-caret {
    transition: transform 0.15s ease;
    font-size: 0.62rem;
  }
  .agent-think.expanded .agent-think-caret {
    transform: rotate(90deg);
  }
  .agent-think-body {
    display: none;
    margin-top: 6px;
    padding: 8px 10px;
    max-height: 180px;
    overflow-y: auto;
    background: var(--card-bg, #fff);
    border: 1px dashed var(--border, #e5e5e5);
    border-radius: 8px;
    line-height: 1.55;
    white-space: pre-wrap;
    word-break: break-word;
  }
  .agent-think.expanded .agent-think-body {
    display: block;
  }
  .agent-think-body::-webkit-scrollbar {
    width: 4px;
  }
  .agent-think-body::-webkit-scrollbar-thumb {
    background: #d8d8d8;
    border-radius: 2px;
  }

  .agent-login {
    margin: auto;
    text-align: center;
    padding: 20px;
  }
  .agent-login p {
    margin: 0 0 14px;
    color: var(--text-light, #666);
  }

  .agent-btn-primary {
    display: inline-block;
    padding: 9px 26px;
    border: none;
    border-radius: 6px;
    background: var(--red, #cc0000);
    color: #fff;
    font-size: 0.95rem;
    cursor: pointer;
    text-decoration: none;
  }
  .agent-btn-primary:hover {
    background: var(--red-dark, #a30000);
    text-decoration: none;
  }

  /* 历史对话恢复入口：面板头部时钟图标 → 会话列表覆盖层 */
  #agent-sessions {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--card-bg, #fff);
    z-index: 2;
  }
  #agent-sessions[hidden] {
    display: none !important;
  }
  .agent-sessions-head {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border-bottom: 1px solid var(--border, #e5e5e5);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--text, #333);
  }
  #agent-sessions-back {
    border: none;
    background: transparent;
    color: var(--blue, #1f4e9c);
    font-size: 0.82rem;
    cursor: pointer;
    padding: 4px 6px;
    border-radius: 6px;
  }
  #agent-sessions-back:hover {
    background: var(--bg, #fafafa);
  }
  #agent-sessions-list {
    flex: 1;
    overflow-y: auto;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .agent-session-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 10px;
    background: var(--bg, #fafafa);
    cursor: pointer;
    text-align: left;
    transition: border-color 0.15s ease, background 0.15s ease;
  }
  .agent-session-item:hover {
    border-color: var(--blue, #1f4e9c);
    background: #fff;
  }
  .agent-session-item.current {
    border-color: var(--red, #cc0000);
  }
  .agent-session-title {
    font-size: 0.85rem;
    color: var(--text, #333);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .agent-session-meta {
    font-size: 0.72rem;
    color: var(--text-light, #666);
  }
  .agent-sessions-empty {
    margin: auto;
    font-size: 0.8rem;
    color: var(--text-light, #666);
    text-align: center;
    padding: 20px;
  }

  /* 设置覆盖层：与历史列表同款结构，可滚动表单 */
  #agent-settings-view {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    background: var(--card-bg, #fff);
    z-index: 2;
  }
  #agent-settings-view[hidden] {
    display: none !important;
  }
  #agent-settings-body {
    flex: 1;
    overflow-y: auto;
    padding: 12px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .agent-set-section h4 {
    margin: 0 0 4px;
    font-size: 0.88rem;
    color: var(--text, #333);
  }
  .agent-set-desc {
    margin: 0 0 10px;
    font-size: 0.72rem;
    line-height: 1.5;
    color: var(--text-light, #666);
  }
  .agent-set-field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-bottom: 10px;
    font-size: 0.75rem;
    color: var(--text-light, #666);
  }
  .agent-set-field input,
  .agent-set-field select {
    padding: 7px 9px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 8px;
    font: inherit;
    font-size: 0.8rem;
    color: var(--text, #333);
    background: var(--bg, #fafafa);
  }
  .agent-set-field input:focus,
  .agent-set-field select:focus {
    outline: none;
    border-color: var(--blue, #1f4e9c);
  }
  .agent-set-actions {
    display: flex;
    gap: 8px;
    margin-top: 2px;
  }
  .agent-set-btn {
    padding: 7px 14px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 8px;
    background: var(--card-bg, #fff);
    color: var(--text, #333);
    font-size: 0.8rem;
    cursor: pointer;
  }
  .agent-set-btn:hover {
    border-color: var(--blue, #1f4e9c);
  }
  .agent-set-btn.primary {
    background: var(--red, #cc0000);
    border-color: var(--red, #cc0000);
    color: #fff;
  }
  .agent-set-btn.primary:hover {
    background: var(--red-dark, #a30000);
    border-color: var(--red-dark, #a30000);
  }
  .agent-set-hint {
    margin: 8px 0 0;
    font-size: 0.72rem;
    color: var(--text-light, #666);
  }
  .agent-set-hint.error {
    color: #a30000;
  }

  #agent-scope {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    padding: 8px 10px 0;
    background: var(--card-bg, #fff);
  }
  #agent-scope[hidden] {
    display: none;
  }
  .agent-scope-chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    max-width: 100%;
    border: 0;
    border-radius: 999px;
    padding: 3px 8px;
    background: #f4e4e4;
    color: #1f1f1f;
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .agent-cites {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 8px;
  }
  .agent-cite {
    border: 0;
    border-radius: 8px;
    padding: 4px 8px;
    text-align: left;
    background: rgba(255, 255, 255, 0.7);
    font: inherit;
    font-size: 0.75rem;
    cursor: pointer;
  }
  .agent-cite-quote {
    margin: 0;
    padding: 6px 8px;
    border-left: 3px solid var(--agent-accent, #cc0000);
    font-size: 0.75rem;
    line-height: 1.45;
    white-space: pre-wrap;
  }
  .cite-ref {
    border: 0;
    padding: 0 2px;
    background: transparent;
    color: var(--blue, #1f4e9c);
    font: inherit;
    font-weight: 700;
    cursor: pointer;
  }
  .agent-input {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    padding: 10px;
    border-top: 1px solid var(--border, #e5e5e5);
    background: var(--card-bg, #fff);
  }
  #agent-input {
    flex: 1;
    resize: none;
    max-height: 110px;
    padding: 8px 10px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 8px;
    font: inherit;
    color: var(--text, #333);
    background: var(--bg, #fafafa);
    line-height: 1.5;
  }
  #agent-input:focus {
    outline: none;
    border-color: var(--blue, #1f4e9c);
  }
  #agent-send {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: none;
    border-radius: 8px;
    background: var(--red, #cc0000);
    color: #fff;
    cursor: pointer;
    transition: background 0.15s ease;
  }
  #agent-send:hover:not(:disabled) {
    background: var(--red-dark, #a30000);
  }
  #agent-send:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }
  #agent-send.is-stop {
    background: #333;
  }
  .agent-identity {
    margin: 2px 0 0;
    font-size: 0.72rem;
    color: var(--text-light, #666);
  }
  .agent-msg-actions {
    position: relative;
    display: flex;
    gap: 2px;
    margin: -6px 0 8px;
  }
  .agent-msg.user + .agent-msg-actions {
    align-self: flex-end;
  }
  .agent-msg-actions button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border: none;
    border-radius: 6px;
    background: transparent;
    color: var(--text-light, #888);
    cursor: pointer;
    padding: 0;
  }
  .agent-msg-actions button:hover {
    background: rgba(0, 0, 0, 0.06);
    color: var(--text, #333);
  }
  .agent-msg-actions button.is-on {
    color: var(--red, #cc0000);
  }
  .agent-msg-actions button[hidden] {
    display: none;
  }
  .agent-edit {
    align-self: flex-end;
    width: min(100%, 420px);
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .agent-edit textarea {
    width: 100%;
    min-height: 72px;
    resize: vertical;
    padding: 8px 10px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 10px;
    font: inherit;
    line-height: 1.5;
  }
  .agent-edit-row {
    display: flex;
    justify-content: flex-end;
    gap: 8px;
  }
  .agent-edit-row button {
    border: 1px solid var(--border, #e5e5e5);
    background: #fff;
    border-radius: 8px;
    padding: 4px 12px;
    font: inherit;
    cursor: pointer;
  }
  .agent-edit-row button.primary {
    background: var(--red, #cc0000);
    border-color: var(--red, #cc0000);
    color: #fff;
  }
  .agent-share-menu {
    position: absolute;
    right: 0;
    top: 30px;
    z-index: 5;
    display: flex;
    flex-direction: column;
    min-width: 132px;
    padding: 4px;
    border: 1px solid var(--border, #e5e5e5);
    border-radius: 8px;
    background: #fff;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.08);
  }
  .agent-share-menu button {
    width: 100%;
    height: auto;
    justify-content: flex-start;
    padding: 6px 8px;
    font: inherit;
    font-size: 0.8rem;
  }

  @media (max-width: 640px) {
    #agent-widget {
      right: 12px;
      bottom: 12px;
    }
    #agent-fab {
      width: 48px;
      height: 48px;
    }
    #agent-panel {
      right: 0;
      bottom: 60px;
      width: calc(100vw - 24px);
      height: min(70vh, 560px);
    }
    .agent-msg {
      max-width: 92%;
    }
    .agent-think {
      width: 92%;
    }
  }
</style>

<script>
  const widget = document.getElementById("agent-widget") as HTMLElement;
  const panel = document.getElementById("agent-panel") as HTMLElement;
  const fab = document.getElementById("agent-fab") as HTMLButtonElement;
  const expandBtn = document.getElementById("agent-expand") as HTMLButtonElement;
  const body = document.getElementById("agent-body") as HTMLElement;
  const input = document.getElementById("agent-input") as HTMLTextAreaElement;
  const sendBtn = document.getElementById("agent-send") as HTMLButtonElement;
  const clearBtn = document.getElementById("agent-clear") as HTMLButtonElement;
  const closeBtn = document.getElementById("agent-close") as HTMLButtonElement;
  const historyBtn = document.getElementById("agent-history") as HTMLButtonElement;
  const sessionsView = document.getElementById("agent-sessions") as HTMLElement;
  const sessionsList = document.getElementById("agent-sessions-list") as HTMLElement;
  const sessionsBack = document.getElementById("agent-sessions-back") as HTMLButtonElement;
  const settingsBtn = document.getElementById("agent-settings") as HTMLButtonElement;
  const settingsView = document.getElementById("agent-settings-view") as HTMLElement;
  const settingsBack = document.getElementById("agent-settings-back") as HTMLButtonElement;
  const NOTICE = (document.querySelector("#agent-body .agent-notice") as HTMLElement)?.outerHTML ?? "";

  let ready = false; // 已确认可对话（已登录 jAccount）
  let streaming = false;
  /** 当前对话归属的会话；null = 下一条消息由服务端新开一场 */
  let currentSessionId: number | null = null;
  /** 进行中的生成。重新开始或停止时作废，避免旧流把会话编号写回来。 */
  let turnGen = 0;
  let abortCtrl: AbortController | null = null;
  let localTurn = 0;
  const SEND_ICON = (document.getElementById("agent-send") as HTMLButtonElement).innerHTML;
  const STOP_ICON =
    '<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><rect x="6" y="6" width="12" height="12" rx="1"/></svg>';

  /* ---------- 自带 API（BYOK）：配置只存本浏览器 localStorage，不经过协会服务器存储 ---------- */

  const LS_KEY = "agent-custom-llm";

  interface CustomLlm {
    baseUrl: string;
    apiKey: string;
    model: string;
    reasoning: string;
  }

  function loadCustom(): CustomLlm | null {
    try {
      const raw = localStorage.getItem(LS_KEY);
      if (!raw) return null;
      const c = JSON.parse(raw) as Partial<CustomLlm>;
      if (!c.baseUrl || !c.apiKey || !c.model) return null;
      return { baseUrl: c.baseUrl, apiKey: c.apiKey, model: c.model, reasoning: c.reasoning || "medium" };
    } catch {
      return null;
    }
  }

  function saveCustom(c: CustomLlm | null): void {
    try {
      if (c) localStorage.setItem(LS_KEY, JSON.stringify(c));
      else localStorage.removeItem(LS_KEY);
    } catch {
      /* 隐私模式等存储异常：本次会话内仍可用内存态 */
    }
  }

  /** 内存态：localStorage 不可用时也能本次会话生效 */
  let customMem: CustomLlm | null = loadCustom();

  /* ---------- 渲染 ---------- */

  function escapeHtml(s: string): string {
    return s.replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!);
  }

  /** 轻量渲染：转义后做链接化 / 换行 / 粗体 / 出处编号 */
  function renderRich(s: string): string {
    let html = escapeHtml(s);
    html = html.replace(/(https?:\/\/[^\s<)"']+)/g, '<a href="$1" target="_blank" rel="noopener noreferrer">$1</a>');
    html = html.replace(/\*\*([^*\n]+)\*\*/g, "<b>$1</b>");
    html = html.replace(/\[(\d+)\]/g, '<button type="button" class="cite-ref" data-n="$1">[$1]</button>');
    return html.replace(/\n/g, "<br>");
  }

  function scrollBottom() {
    requestAnimationFrame(() => {
      body.scrollTop = body.scrollHeight;
    });
  }

  function addMsg(role: "user" | "assistant" | "status" | "error", text: string): HTMLElement {
    /* 用户看到错误提示即上报（BaseLayout 定义的全局采集钩子），运营侧能第一时间知道用户踩了 bug */
    if (role === "error" && typeof window.__reportClientError === "function") {
      window.__reportClientError({ kind: "ui", msg: text });
    }
    const div = document.createElement("div");
    div.className = `agent-msg ${role}`;
    if (role === "status") {
      div.textContent = text;
    } else if (role === "user") {
      div.textContent = text;
    } else {
      div.innerHTML = renderRich(text);
    }
    body.appendChild(div);
    scrollBottom();
    return div;
  }

  const ICON = {
    edit: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4z"/></svg>',
    copy: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>',
    share: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 12v8a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-8"/><polyline points="16 6 12 2 8 6"/><line x1="12" y1="2" x2="12" y2="15"/></svg>',
    undo: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-15-6.7L3 13"/></svg>',
    up: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 10v12"/><path d="M15 5.88 14 10h5.83a2 2 0 0 1 1.92 2.56l-2.33 8A2 2 0 0 1 17.5 22H4a2 2 0 0 1-2-2v-8a2 2 0 0 1 2-2h2.76a2 2 0 0 0 1.79-1.11L12 2a3.13 3.13 0 0 1 3 3.88Z"/></svg>',
    down: '<svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 14V2"/><path d="M9 18.12 10 14H4.17a2 2 0 0 1-1.92-2.56l2.33-8A2 2 0 0 1 6.5 2H20a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2h-2.76a2 2 0 0 0-1.79 1.11L12 22a3.13 3.13 0 0 1-3-3.88Z"/></svg>',
  };

  function iconButton(title: string, svg: string): HTMLButtonElement {
    const button = document.createElement("button");
    button.type = "button";
    button.title = title;
    button.setAttribute("aria-label", title);
    button.innerHTML = svg;
    return button;
  }

  async function copyText(text: string, button: HTMLButtonElement) {
    const icon = button.innerHTML;
    try {
      await navigator.clipboard.writeText(text);
      button.title = "已复制";
    } catch {
      button.title = "复制失败";
    }
    setTimeout(() => {
      button.title = "复制";
      button.innerHTML = icon;
    }, 1200);
  }

  function closeShareMenus() {
    body.querySelectorAll(".agent-share-menu").forEach((node) => node.remove());
  }

  async function shareConversation(scope: "turn" | "all", retractId: string) {
    if (!currentSessionId) {
      addMsg("error", "这场对话还没有保存，稍后再分享。");
      return;
    }
    try {
      const res = await fetch("/api/agent/share", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          sessionId: currentSessionId,
          ...(scope === "turn" ? { messageId: Number(retractId) } : {}),
        }),
      });
      const data = await res.json().catch(() => ({}));
      if (!res.ok || !data.url) {
        addMsg("error", "分享没有生成，请稍后重试。");
        return;
      }
      await navigator.clipboard.writeText(data.url);
      addMsg("status", "分享链接已复制，可以发给别人打开。");
    } catch {
      addMsg("error", "分享没有生成，请稍后重试。");
    }
  }

  function openShareMenu(anchor: HTMLElement, retractId: string) {
    closeShareMenus();
    const menu = document.createElement("div");
    menu.className = "agent-share-menu";
    const one = document.createElement("button");
    one.type = "button";
    one.textContent = "分享这一轮";
    one.addEventListener("click", () => {
      menu.remove();
      void shareConversation("turn", retractId);
    });
    const all = document.createElement("button");
    all.type = "button";
    all.textContent = "分享整个对话";
    all.addEventListener("click", () => {
      menu.remove();
      void shareConversation("all", retractId);
    });
    menu.append(one, all);
    anchor.appendChild(menu);
  }

  async function voteMessage(el: HTMLElement, button: HTMLButtonElement, vote: 1 | -1) {
    const messageId = Number(el.dataset.messageId || "");
    if (!messageId) return;
    const current = Number(el.dataset.vote || "0");
    const next = current === vote ? 0 : vote;
    try {
      const res = await fetch("/api/agent/feedback", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messageId, vote: next }),
      });
      if (!res.ok) return;
      el.dataset.vote = String(next);
      const bar = button.parentElement;
      bar?.querySelectorAll("[data-vote]").forEach((node) => {
        node.classList.toggle("is-on", Number((node as HTMLElement).dataset.vote) === next && next !== 0);
      });
    } catch {
      /* 表态失败时保持原图标 */
    }
  }

  function beginEdit(el: HTMLElement) {
    if (streaming) return;
    const original = el.dataset.plain || "";
    const box = document.createElement("div");
    box.className = "agent-edit";
    box.dataset.turn = el.dataset.turn || "";
    const area = document.createElement("textarea");
    area.value = original;
    const row = document.createElement("div");
    row.className = "agent-edit-row";
    const cancel = document.createElement("button");
    cancel.type = "button";
    cancel.textContent = "取消";
    const ok = document.createElement("button");
    ok.type = "button";
    ok.className = "primary";
    ok.textContent = "发送";
    cancel.addEventListener("click", () => {
      box.replaceWith(el);
      refreshEditButtons();
    });
    ok.addEventListener("click", async () => {
      const next = area.value.trim();
      if (!next) return;
      const id = Number(el.dataset.retractId || "");
      const turn = el.dataset.turn || "";
      if (id) {
        const removed = await retractTurn(id, turn);
        if (!removed) return;
      } else {
        body.querySelectorAll(`[data-turn="${CSS.escape(turn)}"]`).forEach((node) => node.remove());
      }
      input.value = next;
      void send();
    });
    row.append(cancel, ok);
    box.append(area, row);
    el.replaceWith(box);
    area.focus();
  }

  function refreshEditButtons() {
    body.querySelectorAll(".agent-edit-btn").forEach((node) => {
      (node as HTMLButtonElement).hidden = true;
    });
    const users = body.querySelectorAll(".agent-msg.user");
    const last = users[users.length - 1] as HTMLElement | undefined;
    const edit = last?.nextElementSibling?.querySelector(".agent-edit-btn") as HTMLButtonElement | null;
    if (edit) edit.hidden = false;
  }

  function attachActions(el: HTMLElement, role: "user" | "assistant") {
    if (el.nextElementSibling?.classList.contains("agent-msg-actions")) return;
    const bar = document.createElement("div");
    bar.className = "agent-msg-actions";
    bar.dataset.turn = el.dataset.turn || "";
    const retractId = () => el.dataset.retractId || el.dataset.messageId || "";
    if (role === "user") {
      const edit = iconButton("编辑", ICON.edit);
      edit.classList.add("agent-edit-btn");
      edit.hidden = true;
      edit.addEventListener("click", () => beginEdit(el));
      bar.appendChild(edit);
    }
    const copy = iconButton("复制", ICON.copy);
    copy.addEventListener("click", () => void copyText(el.dataset.plain || "", copy));
    bar.appendChild(copy);
    const share = iconButton("分享", ICON.share);
    share.addEventListener("click", (event) => {
      event.stopPropagation();
      openShareMenu(bar, retractId());
    });
    bar.appendChild(share);
    if (role === "user") {
      const undo = iconButton("撤回", ICON.undo);
      undo.addEventListener("click", () => {
        const id = Number(retractId());
        if (id) void retractTurn(id, el.dataset.turn || "");
      });
      bar.appendChild(undo);
    }
    if (role === "assistant") {
      const up = iconButton("有用", ICON.up);
      up.dataset.vote = "1";
      const down = iconButton("没用", ICON.down);
      down.dataset.vote = "-1";
      const current = Number(el.dataset.vote || "0");
      if (current === 1) up.classList.add("is-on");
      if (current === -1) down.classList.add("is-on");
      up.addEventListener("click", () => void voteMessage(el, up, 1));
      down.addEventListener("click", () => void voteMessage(el, down, -1));
      bar.append(up, down);
    }
    el.insertAdjacentElement("afterend", bar);
    refreshEditButtons();
  }

  async function retractTurn(messageId: number, turn: string): Promise<boolean> {
    if (streaming) stopStreaming();
    try {
      const res = await fetch("/api/agent/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ messageId }),
      });
      if (!res.ok) {
        addMsg("error", "撤回失败，请稍后重试。");
        return false;
      }
      body.querySelectorAll(`[data-turn="${CSS.escape(turn)}"]`).forEach((node) => node.remove());
      refreshEditButtons();
      return true;
    } catch {
      addMsg("error", "撤回失败，请稍后重试。");
      return false;
    }
  }

  function stopStreaming() {
    abortCtrl?.abort();
    abortCtrl = null;
  }

  interface ThinkBlock {
    root: HTMLElement;
    toggle: HTMLButtonElement;
    bodyEl: HTMLElement;
  }

  /**
   * 助手消息的思考折叠块：
   *  - 流式阶段 expanded=true，正文出现后收起（collapsed label：「已深度思考 · 点击查看」）
   *  - 点击 toggle 随时展开 / 收起
   */
  function makeThinkBlock(initialExpanded: boolean): ThinkBlock {
    const root = document.createElement("div");
    root.className = `agent-think${initialExpanded ? " expanded" : ""}`;
    const toggle = document.createElement("button");
    toggle.type = "button";
    toggle.className = "agent-think-toggle";
    const label = document.createElement("span");
    label.className = "agent-think-label";
    label.textContent = "正在深度思考…";
    const caret = document.createElement("span");
    caret.className = "agent-think-caret";
    caret.textContent = "▶";
    toggle.append(caret, label);
    const bodyEl = document.createElement("div");
    bodyEl.className = "agent-think-body";
    root.append(toggle, bodyEl);
    body.appendChild(root);

    const tb: ThinkBlock = { root, toggle, bodyEl };
    toggle.addEventListener("click", () => {
      const open = !tb.root.classList.contains("expanded");
      tb.root.classList.toggle("expanded", open);
      if (open) tb.bodyEl.scrollTop = 0; /* 展开定位到思考开头 */
    });
    return tb;
  }

  /** 流式中：追加思考文本，保持滚动到底 */
  function appendThinking(tb: ThinkBlock, text: string) {
    tb.bodyEl.textContent += text;
    tb.bodyEl.scrollTop = tb.bodyEl.scrollHeight;
    /* 思考中面板整体也跟随，避免长思考把输入框顶出视野 */
    scrollBottom();
  }


  /** 思考结束（正文开始）：自动收起，摘要行可点击展开 */
  function collapseThinking(tb: ThinkBlock) {
    tb.root.classList.remove("expanded");
    const label = tb.toggle.querySelector(".agent-think-label") as HTMLElement;
    label.textContent = "已深度思考 · 点击查看";
  }

  /** 恢复历史时：直接渲染为收起态的思考块（点开可看全程） */
  function addHistoryThink(text: string): ThinkBlock {
    const tb = makeThinkBlock(false);
    tb.bodyEl.textContent = text;
    tb.bodyEl.scrollTop = 0; /* 展开时从头可读 */
    const label = tb.toggle.querySelector(".agent-think-label") as HTMLElement;
    label.textContent = "已深度思考 · 点击查看";
    return tb;
  }

  function resetBody() {
    body.innerHTML = NOTICE;
  }

  /** 把一段消息序列渲染成红/蓝气泡（历史恢复与刷新载入共用） */
  function renderMessages(msgs: { id?: number; role: string; content: string; thinking?: string | null; vote?: number | null }[]) {
    for (let i = 0; i < msgs.length; i++) {
      const m = msgs[i];
      const prev = msgs[i - 1];
      const retractId = m.role === "user" ? m.id : prev?.role === "user" ? prev.id : m.id;
      const turn = String(retractId || `h${i}`);
      if (m.role === "assistant" && m.thinking) {
        const tb = addHistoryThink(m.thinking);
        tb.root.dataset.turn = turn;
      }
      if (m.role !== "user" && m.role !== "assistant") continue;
      const el = addMsg(m.role, m.content);
      el.dataset.turn = turn;
      el.dataset.plain = m.content;
      if (m.id) el.dataset.messageId = String(m.id);
      if (retractId) el.dataset.retractId = String(retractId);
      if (m.role === "assistant" && (m.vote === 1 || m.vote === -1)) el.dataset.vote = String(m.vote);
      attachActions(el, m.role);
    }
    scrollBottom();
  }

  function showLoginPrompt() {
    resetBody();
    const box = document.createElement("div");
    box.className = "agent-login";
    const p = document.createElement("p");
    p.textContent = "登录 jAccount 后即可使用智能助手";
    const a = document.createElement("a");
    a.className = "agent-btn-primary";
    a.href = `/api/auth/login?redirect=${encodeURIComponent(location.pathname + location.search)}`;
    a.textContent = "去登录";
    box.append(p, a);
    body.appendChild(box);
  }

  /* ---------- 打开 / 关闭 ---------- */

  const FS_KEY = "agent-panel-fullscreen";
  let wantFullscreen = false;
  try {
    wantFullscreen = localStorage.getItem(FS_KEY) === "1";
  } catch {
    /* 无痕模式写不了 localStorage，只在本次打开期间记住 */
  }

  function syncFullscreenButton() {
    expandBtn.setAttribute("aria-pressed", String(wantFullscreen));
    const label = wantFullscreen ? "退出全屏" : "全屏交流";
    expandBtn.title = label;
    expandBtn.setAttribute("aria-label", label);
  }

  /** 全屏类只在面板打开时挂上，避免隐藏面板时挡住整页点击 */
  function applyFullscreen() {
    const on = wantFullscreen && !panel.hidden;
    widget.classList.toggle("is-fullscreen", on);
    document.documentElement.classList.toggle("agent-fullscreen-lock", on);
    syncFullscreenButton();
    autoGrow();
  }

  function setWantFullscreen(on: boolean) {
    wantFullscreen = on;
    try {
      localStorage.setItem(FS_KEY, on ? "1" : "0");
    } catch {
      /* 忽略 */
    }
    applyFullscreen();
    if (!panel.hidden) input.focus();
  }

  function setLecturePicking(on: boolean) {
    document.documentElement.classList.toggle("agent-picking", on);
  }

  async function openPanel() {
    panel.hidden = false;
    setLecturePicking(true);
    applyFullscreen();
    fab.setAttribute("aria-label", "收起智能助手");
    if (!ready) {
      /* 直接探测历史接口：200 = 已登录；401 = 需要登录 */
      try {
        const res = await fetch("/api/agent/history");
        if (res.status === 401) {
          showLoginPrompt();
          return;
        }
        ready = true;
        await refreshIdentity();
        if (currentSessionId === null) await restoreRememberedSession();
      } catch {
        ready = true; /* 网络抖动不拦着，发消息时再报错 */
      }
    }
    input.focus();
  }

  async function refreshIdentity() {
    try {
      const res = await fetch("/api/agent/sessions");
      if (!res.ok) return;
      const data = await res.json();
      const head = panel.querySelector(".agent-head-info");
      if (!head) return;
      let badge = head.querySelector(".agent-identity") as HTMLElement | null;
      if (!badge) {
        badge = document.createElement("p");
        badge.className = "agent-identity";
        head.appendChild(badge);
      }
      badge.textContent = data.identity || "";
    } catch {
      /* 身份角标失败不影响对话 */
    }
  }

  function rememberSession(id: number | null) {
    try {
      if (id) sessionStorage.setItem("agent-session", String(id));
      else sessionStorage.removeItem("agent-session");
    } catch {
      /* 隐私模式不影响当前页里的会话 */
    }
  }

  /** 刷新后回到这一页正在进行的那场；没有记录才接最近一场。 */
  async function restoreRememberedSession() {
    let saved = 0;
    try {
      saved = Number(sessionStorage.getItem("agent-session") || "");
    } catch {
      saved = 0;
    }
    if (saved > 0) {
      const res = await fetch(`/api/agent/sessions?id=${saved}`);
      if (res.ok) {
        await loadSession(saved, false);
        return;
      }
      currentSessionId = saved;
      rememberSession(saved);
      return;
    }
    await loadLatestSession();
  }

  /** 载入最近一场对话（打开面板时自动续上） */
  async function loadLatestSession() {
    try {
      const res = await fetch("/api/agent/sessions");
      if (!res.ok) return;
      const data = await res.json();
      const sessions = data.sessions ?? [];
      if (sessions.length === 0) return;
      await loadSession(sessions[0].session_id, false);
    } catch {
      /* 网络异常时保持空白新会话即可 */
    }
  }

  /** 恢复指定会话：完整重放该场消息（红/蓝气泡 + 思考块），并把后续提问续在场内 */
  async function loadSession(sessionId: number, announce = true) {
    try {
      const res = await fetch(`/api/agent/sessions?id=${sessionId}`);
      if (!res.ok) return;
      const data = await res.json();
      const msgs = data.messages ?? [];
      if (msgs.length === 0) return;
      currentSessionId = sessionId;
      rememberSession(sessionId);
      resetBody();
      if (announce) {
        const sep = document.createElement("div");
        sep.className = "agent-resume";
        sep.textContent = "已恢复该场对话，可继续提问";
        body.appendChild(sep);
      }
      renderMessages(msgs);
    } catch {
      addMsg("error", "恢复对话失败，请稍后重试。");
    }
  }

  /* ---------- 历史对话列表 ---------- */

  function fmtTime(ts: number): string {
    const d = new Date(ts);
    const now = new Date();
    const sameDay = d.toDateString() === now.toDateString();
    const hm = `${String(d.getHours()).padStart(2, "0")}:${String(d.getMinutes()).padStart(2, "0")}`;
    return sameDay ? `今天 ${hm}` : `${d.getMonth() + 1}/${d.getDate()} ${hm}`;
  }

  async function showSessions() {
    if (!ready) {
      await openPanel();
      if (!ready) return;
    }
    sessionsList.innerHTML = "";
    const empty = document.createElement("p");
    empty.className = "agent-sessions-empty";
    empty.textContent = "正在加载历史对话…";
    sessionsList.appendChild(empty);
    sessionsView.hidden = false;
    try {
      const res = await fetch("/api/agent/sessions");
      if (!res.ok) throw new Error();
      const data = await res.json();
      const sessions = data.sessions ?? [];
      sessionsList.innerHTML = "";
      if (sessions.length === 0) {
        const p = document.createElement("p");
        p.className = "agent-sessions-empty";
        p.textContent = "还没有历史对话，先聊一句吧";
        sessionsList.appendChild(p);
        return;
      }
      for (const s of sessions) {
        const item = document.createElement("button");
        item.type = "button";
        item.className = `agent-session-item${s.session_id === currentSessionId ? " current" : ""}`;
        item.dataset.sessionId = String(s.session_id);
        const title = document.createElement("span");
        title.className = "agent-session-title";
        title.textContent = s.title || "(无提问)";
        const meta = document.createElement("span");
        meta.className = "agent-session-meta";
        meta.textContent = `${fmtTime(s.last_active_at)} · ${s.message_count} 条消息`;
        item.append(title, meta);
        item.addEventListener("click", () => {
          void loadSession(s.session_id);
          sessionsView.hidden = true;
          input.focus();
        });
        sessionsList.appendChild(item);
      }
    } catch {
      sessionsList.innerHTML = "";
      const p = document.createElement("p");
      p.className = "agent-sessions-empty";
      p.textContent = "加载失败，请稍后重试";
      sessionsList.appendChild(p);
    }
  }

  function hideSessions() {
    sessionsView.hidden = true;
  }

  historyBtn.addEventListener("click", showSessions);
  sessionsBack.addEventListener("click", () => {
    hideSessions();
    input.focus();
  });

  /* ---------- 设置页 ---------- */

  const customBaseUrl = document.getElementById("agent-custom-baseurl") as HTMLInputElement;
  const customKey = document.getElementById("agent-custom-key") as HTMLInputElement;
  const customModel = document.getElementById("agent-custom-model") as HTMLInputElement;
  const customReasoning = document.getElementById("agent-custom-reasoning") as HTMLSelectElement;
  const customSave = document.getElementById("agent-custom-save") as HTMLButtonElement;
  const customClear = document.getElementById("agent-custom-clear") as HTMLButtonElement;
  const customStatus = document.getElementById("agent-custom-status") as HTMLElement;
  const adminSection = document.getElementById("agent-admin-section") as HTMLElement;
  const adminModel = document.getElementById("agent-admin-model") as HTMLInputElement;
  const adminReasoning = document.getElementById("agent-admin-reasoning") as HTMLSelectElement;
  const adminSave = document.getElementById("agent-admin-save") as HTMLButtonElement;
  const adminStatus = document.getElementById("agent-admin-status") as HTMLElement;

  /* 顶部标题旁的当前模型角标：自带 API 时提示用户正在消耗自己的额度 */
  function updateModeBadge(): void {
    const head = panel.querySelector(".agent-head-info");
    if (!head) return;
    let badge = head.querySelector(".agent-mode-badge") as HTMLElement | null;
    if (customMem) {
      if (!badge) {
        badge = document.createElement("p");
        badge.className = "agent-mode-badge";
        head.appendChild(badge);
      }
      badge.textContent = `自带 API · ${customMem.model}`;
    } else {
      badge?.remove();
    }
