---
import { siteName, navItems } from "../config";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand">
      <img src="/images/img06.jpg" alt="协会会徽" class="brand-logo" />
      <span class="brand-name">{siteName}</span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-label="展开导航" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" id="site-nav">
      <ul>
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ active: item.href === "/" ? currentPath === "/" : currentPath.startsWith(item.href) }]}
              aria-current={item.href === "/" ? (currentPath === "/" ? "page" : undefined) : (currentPath.startsWith(item.href) ? "page" : undefined)}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-auth">
          <a href="/login" id="auth-entry" class="auth-link">登录</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  // 登录态：静态页统一向 /api/auth/me 查询（未登录时保持「登录」入口指向 /login）
  const authEntry = document.getElementById("auth-entry");
  if (authEntry) {
    fetch("/api/auth/me")
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (d?.authenticated) {
          authEntry.textContent = d.user?.mock ? "演示身份 · 退出" : `${d.user?.name || d.user?.account} · 退出`;
          authEntry.href = "/api/auth/logout";
          authEntry.classList.add("logged-in");
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    flex-shrink: 0;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-logo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--blue-dark);
    white-space: nowrap;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 4px;
  }

  .site-nav a {
    display: block;
    padding: 8px 12px;
    color: var(--text);
    font-size: 0.95rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--red);
    text-decoration: none;
    background: #fbf3f3;
  }

  .site-nav a.active {
    color: var(--red);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--red);
    border-radius: 6px 6px 0 0;
  }

  .nav-auth {
    margin-left: 8px;
    display: flex;
    align-items: center;
  }

  .auth-link {
    display: block;
    padding: 6px 18px !important;
    border: 1px solid var(--blue) !important;
    border-radius: 999px !important;
    color: var(--blue) !important;
    font-weight: 600;
  }

  .auth-link.logged-in {
    border-color: var(--border) !important;
    color: var(--text-light) !important;
    font-weight: 400;
    max-width: 12em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    padding: 8px;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--text);
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 64px;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .site-nav.open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      padding: 8px 24px 16px;
    }

    .site-nav a.active {
      box-shadow: none;
      background: #fbf3f3;
      border-radius: 6px;
    }
  }
</style>
