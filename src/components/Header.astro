---
import { siteName, navItems } from "../config";

const currentPath = Astro.url.pathname.replace(/\/+$/, "") || "/";
const base =
  currentPath === "/next" || currentPath.startsWith("/next/")
    ? "/next"
    : currentPath === "/staff" || currentPath.startsWith("/staff/")
      ? "/staff"
      : "";
const items = navItems.map((item) => ({
  label: item.label,
  href: base ? (item.href === "/" ? base : `${base}${item.href}`) : item.href,
}));
if (base === "/staff") items.push({ href: "/staff/admins", label: "管理员名单" });

function isCurrent(href: string): boolean {
  if (href === "/" || href === "/next" || href === "/staff") return currentPath === href;
  return currentPath === href || currentPath.startsWith(`${href}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a href={base || "/"} class="brand">
      <img src="/images/img06.jpg" alt="协会会徽" class="brand-logo" />
      <span class="brand-name">{siteName}</span>
    </a>
    <button class="nav-toggle" id="nav-toggle" aria-label="展开导航" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
    <nav class="site-nav" id="site-nav">
      <ul>
        {items.map((item) => (
          <li>
            <a
              href={item.href}
              class:list={[{ active: isCurrent(item.href) }]}
              aria-current={isCurrent(item.href) ? "page" : undefined}
            >
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav-auth">
          <a href="/login" id="auth-entry" class="auth-link">登录</a>
        </li>
      </ul>
    </nav>
  </div>
  <div class="view-switch" id="view-switch" hidden>
    <div class="container view-switch-inner">
      <span class="view-switch-label">视角</span>
      <a href="/" data-view="public">用户视角</a>
      <a href="/next" data-view="next">下一版本</a>
      <a href="/staff" data-view="staff">管理员视角</a>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("nav-toggle");
  const nav = document.getElementById("site-nav");
  toggle?.addEventListener("click", () => {
    const open = nav?.classList.toggle("open") ?? false;
    toggle.setAttribute("aria-expanded", String(open));
  });

  // 登录态：静态页统一向 /api/auth/me 查询（未登录时保持「登录」入口指向 /login）
  const authEntry = document.getElementById("auth-entry");
  if (authEntry) {
    fetch("/api/auth/me")
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (d?.authenticated) {
          authEntry.textContent = d.user?.mock ? "演示身份 · 退出" : `${d.user?.name || d.user?.account} · 退出`;
          authEntry.href = "/api/auth/logout";
          authEntry.classList.add("logged-in");
        }
        if (d?.admin) {
          const path = location.pathname.replace(/\/+$/, "") || "/";
          const view = path === "/next" || path.startsWith("/next/") ? "next" : path === "/staff" || path.startsWith("/staff/") ? "staff" : "public";
          let rest = path;
          if (view === "next") rest = path.slice("/next".length) || "/";
          else if (view === "staff") rest = path.slice("/staff".length) || "/";
          if (rest === "/admins" || rest.startsWith("/admins/")) rest = "/";
          const bar = document.getElementById("view-switch");
          bar?.querySelectorAll("a[data-view]").forEach((link) => {
            const id = link.getAttribute("data-view");
            const prefix = id === "next" ? "/next" : id === "staff" ? "/staff" : "";
            link.setAttribute("href", prefix ? (rest === "/" ? prefix : prefix + rest) : rest);
            if (id === view) link.setAttribute("aria-current", "page");
            else link.removeAttribute("aria-current");
          });
          bar?.removeAttribute("hidden");
        }
      })
      .catch(() => {});
  }
</script>

<style>
  .site-header {
    background: #fff;
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    flex-shrink: 0;
  }

  .brand:hover {
    text-decoration: none;
  }

  .brand-logo {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }

  .brand-name {
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--blue-dark);
    white-space: nowrap;
  }

  .site-nav ul {
    display: flex;
    flex-wrap: wrap;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 4px;
  }

  .site-nav a {
    display: block;
    padding: 8px 12px;
    color: var(--text);
    font-size: 0.95rem;
    border-radius: 6px;
    white-space: nowrap;
  }

  .site-nav a:hover {
    color: var(--red);
    text-decoration: none;
    background: #fbf3f3;
  }

  .site-nav a.active {
    color: var(--red);
    font-weight: 600;
    box-shadow: inset 0 -2px 0 var(--red);
    border-radius: 6px 6px 0 0;
  }

  .nav-auth {
    margin-left: 8px;
    display: flex;
    align-items: center;
  }

  .auth-link {
    display: block;
    padding: 6px 18px !important;
    border: 1px solid var(--blue) !important;
    border-radius: 999px !important;
    color: var(--blue) !important;
    font-weight: 600;
  }

  .auth-link.logged-in {
    border-color: var(--border) !important;
    color: var(--text-light) !important;
    font-weight: 400;
    max-width: 12em;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
    padding: 8px;
  }

  .nav-toggle span {
    display: block;
    height: 2px;
    background: var(--text);
  }

  .view-switch {
    background: #fff8e6;
    border-top: 1px solid #ecd9a0;
  }

  .view-switch-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    min-height: 42px;
    padding-top: 6px;
    padding-bottom: 6px;
  }

  .view-switch-label {
    color: #7a6413;
    font-size: 0.85rem;
    font-weight: 600;
    margin-right: 4px;
  }

  .view-switch a {
    display: inline-block;
    padding: 4px 12px;
    border-radius: 999px;
    color: var(--text);
    font-size: 0.9rem;
    border: 1px solid #ecd9a0;
    background: #fff;
  }

  .view-switch a:hover {
    text-decoration: none;
    color: var(--blue-dark);
  }

  .view-switch a[aria-current="page"] {
    background: var(--blue);
    color: #fff;
    border-color: var(--blue);
  }

  @media (max-width: 900px) {
    .nav-toggle {
      display: flex;
    }

    .site-nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }

    .site-nav.open {
      display: block;
    }

    .site-nav ul {
      flex-direction: column;
      padding: 8px 24px 16px;
    }

    .site-nav a.active {
      box-shadow: none;
      background: #fbf3f3;
      border-radius: 6px;
    }
  }
</style>
