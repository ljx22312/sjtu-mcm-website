# ============================================================
# jAccount 登录配置（复制为 .env 或写入服务环境变量）
# ============================================================
# 交我办「流程 → 网络服务 → jAccount 接口申请」审批通过后，
# 在返回的应用信息里找到 client_id / client_secret 填到这里。
# 申请时登记的回调地址必须是：https://<你的域名>/api/auth/callback
JACCOUNT_CLIENT_ID=
JACCOUNT_CLIENT_SECRET=

# 会话 cookie 签名密钥（必须设置，否则服务重启后所有人需重新登录）
# 生成：openssl rand -hex 32
AUTH_SESSION_SECRET=

# 正式凭据配置后是否仍保留演示登录（不设则自动关闭；设 1 保持开启）

# Node 服务监听地址（部署时按需修改；详见 docs/jaccount-auth.md）
# HOST=127.0.0.1
# PORT=4321

# ============================================================
# 网页导览 agent（右下角智能助手）配置
# ============================================================
# 智谱 BigModel API Key（https://open.bigmodel.cn → API Keys）
# 配置后进入正式模式；不配置则为演示模式（返回联调提示，不调用模型）
AGENT_API_KEY=
# 模型端点（Anthropic 兼容协议）与模型 id（可选 glm-4.6 / glm-4.5-air）
# AGENT_BASE_URL=https://open.bigmodel.cn/api/anthropic
# AGENT_MODEL=glm-4.6
# 配置正式 Key 后是否仍允许模型演示模式（默认否；模型层降级用，与登录无关）
# AGENT_ALLOW_MOCK=0
# 协会额度窗口制：从用户首条提问起算一个窗口，窗口内最多 N 条，到期整窗恢复，
# 下次提问再开新窗（历史库持久计数，重启不清零；不设每日上限）
# AGENT_WINDOW_MESSAGES=60
# AGENT_WINDOW_MINUTES=300
# 自带 API 用户每小时的的消息数上限（花自己的额度，仅防失控；默认 100）
# AGENT_RATE_LIMIT_CUSTOM=100
# 按账号的窗口条数覆盖在 /staff/agent 管理页调整，存 data/agent-limits.json，改完即生效
# 管理员 jAccount 账号（逗号分隔；与 data/agent-admin.json 的 admins 合并，
# 管理员可在助手面板「模型设置」里调整官方模型用户的模型与思考深度）
# AGENT_ADMIN_ACCOUNTS=
# 官方模型运行参数文件路径（默认 data/agent-admin.json，内容见 docs/agent.md）
# AGENT_ADMIN_CONFIG=data/agent-admin.json
# 对话历史 SQLite 路径与保留天数（默认 data/agent-history.db、180 天）
# AGENT_HISTORY_DB=data/agent-history.db
# AGENT_HISTORY_RETENTION_DAYS=180

# ============================================================
# 网站管理员（下一版本 / 管理员视角）
# ============================================================
# jAccount 账号，逗号分隔，与 data/site-admins.json 的 admins 合并。
# 页面 /staff 可以增删文件里的账号；环境变量里的账号不能在页面上删除。
# 名单为空时，没有人能打开 /next 和 /staff。
# 与上面的 AGENT_ADMIN_ACCOUNTS（助手模型参数）不是同一份名单。
# 文件格式：{ "admins": ["账号"] }，默认路径 data/site-admins.json（不入库）
# SITE_ADMIN_ACCOUNTS=
# SITE_ADMIN_CONFIG=data/site-admins.json
