# ============================================================
# jAccount 登录配置（复制为 .env 或写入服务环境变量）
# ============================================================
# 交我办「流程 → 网络服务 → jAccount 接口申请」审批通过后，
# 在返回的应用信息里找到 client_id / client_secret 填到这里。
# 申请时登记的回调地址必须是：https://<你的域名>/api/auth/callback
JACCOUNT_CLIENT_ID=
JACCOUNT_CLIENT_SECRET=

# 会话 cookie 签名密钥（必须设置，否则服务重启后所有人需重新登录）
# 生成：openssl rand -hex 32
AUTH_SESSION_SECRET=

# 正式凭据配置后是否仍保留演示登录（不设则自动关闭；设 1 保持开启）
# AUTH_ALLOW_MOCK=0

# Node 服务监听地址（部署时按需修改；详见 docs/jaccount-auth.md）
# HOST=127.0.0.1
# PORT=4321

# ============================================================
# 网页导览 agent（右下角智能助手）配置
# ============================================================
# 智谱 BigModel API Key（https://open.bigmodel.cn → API Keys）
# 配置后进入正式模式；不配置则为演示模式（返回联调提示，不调用模型）
AGENT_API_KEY=
# 模型端点（Anthropic 兼容协议）与模型 id（可选 glm-4.6 / glm-4.5-air）
# AGENT_BASE_URL=https://open.bigmodel.cn/api/anthropic
# AGENT_MODEL=glm-4.6
# 配置正式 Key 后是否仍允许演示模式（默认否）
# AGENT_ALLOW_MOCK=0
# 内测期临时开关：设 1 时未登录也能使用助手（匿名访客共用同一份对话历史；
# 正式部署务必保持关闭，回到 jAccount 登录门槛）
# AGENT_ALLOW_ANONYMOUS=0
# 每用户每小时可发送的消息数（默认 20）
# AGENT_RATE_LIMIT=20
# 对话历史 SQLite 路径与保留天数（默认 data/agent-history.db、180 天）
# AGENT_HISTORY_DB=data/agent-history.db
# AGENT_HISTORY_RETENTION_DAYS=180
